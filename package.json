{
  "name": "offmenu-web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node scripts/build.mjs",
    "check:generated": "node scripts/check-generated-extension.mjs",
    "test": "node --test tests/web/*.test.mjs",
    "i18n:extract": "node scripts/i18n-catalogue.mjs",
    "i18n:check": "node scripts/i18n-catalogue.mjs --check",
    "test:locale-edge": "node --test tests/edge/*.test.mjs",
    "test:auth": "node --test tests/web/auth-principal.test.mjs tests/edge/better-auth.test.mjs",
    "validate:dev": "node scripts/validate.mjs dev",
    "validate:release": "node scripts/validate.mjs release",
    "check:repository": ".venv-delivery/bin/python -m offmenu.delivery check",
    "delivery:bootstrap": "python3 scripts/bootstrap_delivery.py",
    "test:delivery": ".venv-delivery/bin/python -m unittest discover -s tests/delivery -v",
    "check:web-imports": "node scripts/check-web-imports.mjs",
    "check:layout": ".venv-delivery/bin/python scripts/check_final_layout.py"
  },
  "dependencies": {
    "@netlify/identity": "^2.0.0",
    "better-auth": "1.7.10",
    "zxing-wasm": "3.1.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "latest",
    "acorn": "^8.19.0",
    "esbuild": "0.25.12",
    "miniflare": "^4.20260730.0"
  },
  "overrides": {
    "miniflare": {
      "undici": "7.30.0",
      "sharp": "0.35.5"
    }
  }
}
