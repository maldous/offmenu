{
  "name": "freebuff-relay",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "wrangler deploy --dry-run --outdir dist",
    "test": "npm run test:unit && npm --prefix poller test",
    "types": "wrangler types",
    "test:unit": "node --import tsx --test test/*.test.ts",
    "test:runtime": "node test/runtime.mjs"
  },
  "dependencies": {
    "@cloudflare/workers-oauth-provider": "1.2.3",
    "@modelcontextprotocol/server": "2.3.1",
    "agents": "0.28.1",
    "jose": "6.2.12",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "26.6.5",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "wrangler": "4.151.1",
    "miniflare": "5.20261012.1-beta",
    "esbuild": "0.28.2"
  }
}
