+test('sparse receipt arrays and non-object or inherited file rows reject before render',async t=>{
+  for(const kind of ['hole','null','undefined','array','inherited','inherited-fields'])await t.test(kind,async t=>{
+    const f=selection(),e=environment(t,f,async options=>{
+      const result=await f.load(options),row=result.receipt.files[0];
+      if(kind==='hole')result.receipt.files=new Array(1);
+      if(kind==='null')result.receipt.files=[null];
+      if(kind==='undefined')result.receipt.files=[undefined];
+      if(kind==='array')result.receipt.files=[Object.assign([],row)];
+      if(kind==='inherited'){
+        result.receipt.files=new Array(1);
+        Object.setPrototypeOf(result.receipt.files,Object.assign(Object.create(Array.prototype),{0:row}));
+      }
+      if(kind==='inherited-fields')result.receipt.files=[Object.create(row)];
+      return result;
+    });
+    await assert.rejects(e.ui.loadSelectedCommonPackage(),/receipt/);
+    assert.equal(e.$('data-results').children.length,0);assert.equal(e.$('data-save').disabled,true);assert.equal(e.$('data-export').disabled,true);assert.deepEqual(e.sideEffects,[]);
+  });
+});
+test('mutable authorization decisions cannot hide policy or scope changes during loading',async t=>{
+  for(const kind of ['shared-policy','cloned-policy','shared-scope-and-loader-options'])await t.test(kind,async t=>{
+    const f=selection({permission:{accountKey:'user:alice'}});
+    if(kind!=='cloned-policy')f.authorize=async()=>f.policy;
+    const e=environment(t,f,async options=>{
+      const result=await f.load(options);
+      if(kind==='shared-scope-and-loader-options'){f.policy.scope.privateOwnerId='alice';options.readerOptions.userId='alice';}
+      else f.policy.policyId='changed-policy';
+      return result;
+    });
+    e.state.user={id:'alice'};
+    await assert.rejects(e.ui.loadSelectedCommonPackage(),/permission changed/);
+    assert.equal(e.$('data-results').children.length,0);assert.equal(e.$('data-save').disabled,true);assert.equal(e.$('data-export').disabled,true);assert.deepEqual(e.sideEffects,[]);
+  });
+});
+test('a stable shared authorization object remains usable without retaining mutable grant references',async t=>{
+  const f=selection();f.authorize=async()=>f.policy;const before=structuredClone(f.policy),e=environment(t,f);
+  await e.ui.loadSelectedCommonPackage();assert.equal(e.$('data-results').children.length,1);assert.deepEqual(f.policy,before);assert.deepEqual(e.sideEffects,[]);
+});
