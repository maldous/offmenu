@@ -158,3 +158,67 @@ test('inputs stay unchanged and returned provenance/action are independent snaps
   assert.deepEqual({ n, l }, before);
   assert.equal(evaluateRecallScope(null, null).applicability, 'unknown');
 });
+
+test('unsupported submillisecond precision is unknown at every temporal gate, never truncated', () => {
+  const cases = [
+    // W10-RECALL-F1: formerly matched even though effective/retrieval ordering fails.
+    { asOf: '2026-10-14T06:00:00.0005Z', retrievedAt: '2026-10-14T06:00:00.0001Z', validFrom: '2026-10-14T06:00:00.0009Z' },
+    { asOf: '2026-10-14T06:00:00.0001Z', retrievedAt: '2026-10-14T06:00:00.0009Z' },
+    // Before a high-precision expiry, the narrowed contract still requires unknown.
+    { asOf: '2026-10-14T06:00:00.0001Z', freshUntil: '2026-10-14T06:00:00.0009Z' },
+    { asOf: '2026-10-14T06:00:00.0001Z', validUntil: '2026-10-14T06:00:00.0009Z' },
+    // Isolate each timestamp: even apparently valid ordering must not admit >3 digits.
+    { validFrom: '2026-10-13T00:00:00.0001Z' },
+    { retrievedAt: '2026-10-14T05:00:00.0001Z' },
+    { asOf: '2026-10-14T06:00:00.0001Z' },
+    { freshUntil: '2026-10-15T00:00:00.0001Z' },
+    { validUntil: '2026-10-15T00:00:00.0001Z' },
+    // Reject excess precision even when trailing zeros happen to be representable.
+    { retrievedAt: '2026-10-14T05:00:00.0000Z' },
+    { validUntil: '2026-10-15T00:00:00.123456789Z' },
+  ];
+  const failures = [];
+  for (const patch of cases) {
+    const n = notice();
+    if (patch.retrievedAt) n.provenance.retrievedAt = patch.retrievedAt;
+    for (const field of ['validFrom', 'freshUntil', 'validUntil']) {
+      if (patch[field]) n.evidence[field] = patch[field];
+    }
+    const before = structuredClone(n);
+    const result = evaluate(n, lot(), patch.asOf ?? asOf);
+    if (result.applicability !== 'unknown' || result.evidenceStatus !== 'unknown') {
+      failures.push({ patch, actual: result.applicability, evidenceStatus: result.evidenceStatus });
+    }
+    assert.deepEqual(n, before);
+    assert.deepEqual(result.provenance, before.provenance);
+  }
+  assert.deepEqual(failures, []);
+});
+
+test('admitted millisecond precision preserves effective, retrieval and exclusive expiry ordering', () => {
+  for (const fraction of ['1', '10', '100']) {
+    const n = notice();
+    n.evidence.validFrom = `2026-10-14T06:00:00.${fraction}Z`;
+    n.provenance.retrievedAt = '2026-10-14T06:00:00.100Z';
+    assert.equal(evaluate(n, lot(), '2026-10-14T06:00:00.1Z').applicability, 'matched');
+  }
+  const clock = '2026-10-14T06:00:00.100Z';
+  for (const patch of [
+    { validFrom: '2026-10-14T06:00:00.101Z', retrievedAt: clock },
+    { retrievedAt: '2026-10-14T06:00:00.101Z' },
+    { validFrom: clock, retrievedAt: '2026-10-14T06:00:00.099Z' },
+    { freshUntil: clock }, { freshUntil: '2026-10-14T06:00:00.099Z' },
+    { validUntil: clock }, { validUntil: '2026-10-14T06:00:00.099Z' },
+  ]) {
+    const n = notice();
+    if (patch.retrievedAt) n.provenance.retrievedAt = patch.retrievedAt;
+    for (const field of ['validFrom', 'freshUntil', 'validUntil']) {
+      if (patch[field]) n.evidence[field] = patch[field];
+    }
+    assert.equal(evaluate(n, lot(), clock).applicability, 'unknown', JSON.stringify(patch));
+  }
+  for (const field of ['freshUntil', 'validUntil']) {
+    const n = notice(); n.evidence[field] = '2026-10-14T06:00:00.101Z';
+    assert.equal(evaluate(n, lot(), clock).applicability, 'matched', field);
+  }
+});
