// Compatible with 00d07283 createRequestBudget's storage.atomic contract.
// Each successful compare-and-swap is one SQLite transaction. Callbacks may rerun.
export function durableBudgetStorage(db, {attempts = 16} = {}) {
  int(attempts, 'attempts', 1);
  if (attempts > 64) throw Error('Too many attempts');
  return {async atomic(scope, update) {
    if (typeof scope !== 'string' || !scope || scope.length > 200) throw Error('Invalid scope');
    for (let n = 0; n < attempts; n++) {
      const row = await db.prepare('SELECT version,document FROM provider_budget_owner30 WHERE scope=?').bind(scope).first();
      if (row) int(row.version + 1, 'next version', 1);
      const result = update(row ? JSON.parse(row.document) : undefined);
      if (!result || result.then || !Object.hasOwn(result, 'state')) throw Error('Synchronous state transition required');
      const document = JSON.stringify(result.state);
      if (typeof document !== 'string' || document.length > 65536) throw Error('Invalid or oversized state');
      const written = row
        ? await db.prepare('UPDATE provider_budget_owner30 SET version=version+1,document=? WHERE scope=? AND version=? RETURNING version').bind(document, scope, int(row.version, 'stored version')).first()
        : await db.prepare('INSERT INTO provider_budget_owner30(scope,version,document) VALUES(?,0,?) ON CONFLICT(scope) DO NOTHING RETURNING version').bind(scope, document).first();
      if (written) return result.value;
