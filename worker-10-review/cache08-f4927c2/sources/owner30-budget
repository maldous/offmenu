        if (s.requests >= maxRequests || spend > maxSpend - s.spend) return {dispatch: false, reason: 'provider-budget', retryAfter: s.start + windowMs};
        if (s.receipts.length >= maxReceipts) return {dispatch: false, reason: 'receipt-capacity'};
