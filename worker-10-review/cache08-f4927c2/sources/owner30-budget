    async reserve({attemptId, fingerprint, spend} = {}) {
      int(spend, 'known upper-bound spend');
      if (![attemptId, fingerprint].every(x => typeof x === 'string' && x.length > 0 && x.length <= 128)) throw Error('Opaque attempt ID and request fingerprint required');
