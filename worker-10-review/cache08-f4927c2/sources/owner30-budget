// Reservation-only consumer. Only dispatch:true permits ONE outbound attempt.
// Never refund ambiguous/crashed attempts. This is not exactly-once transport.
export function durableQuota({storage, scope, clock, windowMs, maxRequests, maxSpend, receiptTTL, maxReceipts = 128}) {
  int(windowMs, 'windowMs', 1); int(maxRequests, 'maxRequests'); int(maxSpend, 'maxSpend');
