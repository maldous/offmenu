    const now = int(clock(), 'clock');
    if (previous) {
      for (const k of ['start', 'requests', 'spend', 'pauseUntil', 'last']) int(previous[k], 'stored ' + k);
      if (!Array.isArray(previous.receipts) || previous.receipts.length > maxReceipts || previous.requests > maxRequests || previous.spend > maxSpend) throw Error('Invalid stored budget');
      for (const r of previous.receipts) {
        int(r.expires, 'stored expiry'); int(r.spend, 'stored price');
        if (typeof r.id !== 'string' || typeof r.fingerprint !== 'string') throw Error('Invalid stored receipt');
      }
    }
    if (previous && (previous.config !== config || previous.last > now)) throw Error('Configuration changed or clock regressed');
    const start = Math.floor(now / windowMs) * windowMs;
    int(start + windowMs, 'window end');
    const state = previous || {config, start, requests: 0, spend: 0, pauseUntil: 0, last: now, receipts: []};
    if (state.start !== start) { state.start = start; state.requests = 0; state.spend = 0; }
    state.receipts = state.receipts.filter(r => r.expires > now);
    state.last = now;
    return {state, value: fn(state, now)};
