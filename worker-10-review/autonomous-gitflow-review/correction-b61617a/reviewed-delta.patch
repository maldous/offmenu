+    def test_local_integrate_rejects_contradictory_ready_owner_and_rehashed_task_alias(self):
+        start, original_start = self.start();source = self.commit('local binding source')
+        ready, original_ready = self.ready(start)
+        alias = 'feature/09/not-authored-task';self.git('branch', alias, source)
+        self.git('switch', 'develop');self.review('develop', source, source)
+        cases = []
+        r = dict(original_ready);r['owner'] = 'different-owner';cases.append(('owner', r))
+        ss = dict(original_start);ss['branch'] = alias
+        fake_start = self.ev / 'alias-local-start.json';fake_start.write_text(json.dumps(ss))
+        r = dict(original_ready);r.update(branch=alias, start_receipt=str(fake_start),
+            start_sha256=hashlib.sha256(fake_start.read_bytes()).hexdigest());cases.append(('task-alias', r))
+        for name, value in cases:
+            path = self.ev / (name + '-local-ready.json');path.write_text(json.dumps(value))
+            _, rec = self.command('integrate', '--worker', '9', '--ready', str(path),
