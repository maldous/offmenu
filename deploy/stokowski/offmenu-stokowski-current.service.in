# Source-only proposal. Render all three markers from independently reviewed inputs.
# Never install this literal template. Manual start only; no boot enablement.
[Unit]
Description=OffMenu qualified current Stokowski coordinator

[Service]
Type=simple
User=user
WorkingDirectory=@REVIEWED_SOURCE_DIRECTORY@
Environment=HOME=/home/user USER=user LOGNAME=user LANG=C.UTF-8
Environment=PATH=/usr/local/bin:/usr/bin:/bin
Environment=CODEX_HOME=/home/user/.codex
UnsetEnvironment=OFFMENU_LINEAR_API_KEY LINEAR_API_KEY
LoadCredential=linear-api-key:REQUIRED_EXISTING_LINEAR_CREDENTIAL_REFERENCE
ExecStart=/home/user/src/offmenu/.delivery/stokowski/venv/bin/python @REVIEWED_SOURCE_DIRECTORY@/tools/delivery/stokowski_adapter.py --current --runtime @QUALIFIED_COORDINATOR_RUNTIME@
UMask=0077
KillSignal=SIGTERM
KillMode=mixed
TimeoutStopSec=120s
Restart=no
StandardOutput=journal
StandardError=journal
