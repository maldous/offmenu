+verifyLiveRunner(receipt,config);
+assert.equal(receipt.status,'ready');
+const base=`http://127.0.0.1:${config.port}`;
+if(receipt.compositionSha256)throw new Error('Composed acceptance requires Worker 08 harness; dev-smoke checks deny-all lifecycle only.');
+const checks=[];
+for(const [path,status] of [['/',200],['/__dev/status',200],['/api/health',200],['/api/recipes',200],['/api/state',401],['/api/product?barcode=0000000000000',502]]) {
+ const response=await fetch(base+path);assert.equal(response.status,status,path);
+ const body=await response.text();const check={path,status:response.status};
+ if(path==='/'){assert.match(body,/Development preview/);assert.match(response.headers.get('content-security-policy'),/connect-src 'self';/);check.banner=true;}
+ if(path==='/__dev/status'){const detail=JSON.parse(body);assert.equal(detail.ownerThread,config.ownerThread);assert.equal(detail.runId,config.runId);assert.equal(detail.stateId,config.stateId);assert.equal(detail.productionCredentials,false);assert.equal(detail.compositionSha256,receipt.compositionSha256||null);assert.equal(detail.composition,receipt.compositionMode||'deny-all');assert.equal(detail.applicationCommit,receipt.applicationCommit);check.environment=detail;}
