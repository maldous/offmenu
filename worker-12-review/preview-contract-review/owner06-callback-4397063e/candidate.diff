+// Local SDK callback INPUT contract only. No redirect, browser intent storage,
+// HTTP listener, state/nonce verification, provider consent or session creation.
+import {ACTORS,identityToken} from './fixtures.mjs';
+import {loopbackOrigin} from './adapter.mjs';
+
+export const CALLBACK_SOURCE_CONTRACT=Object.freeze({
+ schema:'offmenu-synthetic-sdk-callback-source/1',
+ api:'offmenu-mocks/1',identitySemantics:'offmenu-identity-session/2',
+ fixtureBaseline:'9b31f7d4de21dd30add0c49b038e5ac31413ec5d',
+ mode:'local-synthetic-only',providerAcceptance:false,consent:'unknown',accountLinking:'unknown',
+ nativeAuthorizeStatus:501,nativeCallbackStatus:501,
+ fragmentOwner:'Worker04 local SDK harness; never a Worker06 redirect response',
+ fragmentAllowedKeys:Object.freeze(['access_token','refresh_token','token_type','expires_in','expires_at','provider']),
+ intentOwner:'Worker04 same-tab sessionStorage provider/start-time guard, 15-minute bound, one consumption; not cryptographic OAuth state/nonce',
+ forbiddenClaims:Object.freeze(['Google provider authentication','cryptographic state/nonce verification','provider consent','account linking','token rotation','session validity inferred from fixed token bytes']),
+ nativeStatusContract:Object.freeze({validToken:200,missingOrWrongCredential:401,duplicateExtraOrMixedFields:400,revokedUser:401,logout:200,repeatedLogout:401}),
+ unsupportedBridges:Object.freeze(['Google provider authorize/callback remains 501','browser extension/native bridge contract not agreed','device/health bridges are not HTTP mocks']),
+});
+const NATIVE_KEYS=Object.freeze(['access_token','refresh_token','token_type','expires_in']);
+function actor(id){if(!Object.hasOwn(ACTORS,id))throw Error('Unknown synthetic actor');return ACTORS[id];}
+
+// Caller sends this only through the selected local createOutboundAdapter.
+// The upstream URL names the existing contract; this function performs no I/O.
+export function callbackSourceTokenRequest(actorId){
+ const a=actor(actorId);
+ return Object.freeze({url:'https://offmenu-accounts.netlify.app/.netlify/identity/token',method:'POST',
+  headers:Object.freeze({'content-type':'application/x-www-form-urlencoded'}),
+  body:new URLSearchParams({grant_type:'password',username:a.email,password:'fixture-password'}).toString(),
+ });
+}
+
+// Validate a newly observed strict native token reply before Worker04 composes
+// its fragment. Matching these fixed values does NOT prove a live session:
+// native user/refresh checks and revocation remain WireMock's responsibility.
+export function validateCallbackSourceReply(actorId,reply,{httpStatus,localOrigin}={}){
+ actor(actorId);const origin=loopbackOrigin(localOrigin);
+ if(httpStatus!==200)throw Error('Successful native token response required');
+ if(!reply||typeof reply!=='object'||Array.isArray(reply))throw Error('Native token object required');
+ if(Object.keys(reply).length!==NATIVE_KEYS.length||Object.keys(reply).some(k=>!NATIVE_KEYS.includes(k)))throw Error('Unsupported or ambiguous native token fields');
+ const expected=identityToken(actorId);
+ for(const key of NATIVE_KEYS)if(reply[key]!==expected[key])throw Error('Native synthetic token/actor/lifetime mismatch');
+ return Object.freeze({schema:CALLBACK_SOURCE_CONTRACT.schema,actorId,localOrigin:origin,
+  tokenFields:Object.freeze(Object.fromEntries(NATIVE_KEYS.map(k=>[k,reply[k]]))),
+  intentVerification:'Must be performed and consumed by Worker04 before SDK handling',
+  providerAcceptance:false,consent:'unknown',accountLinking:'unknown',
+  currentSessionVerified:false,callbackEndpointStatus:501,
+ });
+}
