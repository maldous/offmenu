+import test from 'node:test';
+import assert from 'node:assert/strict';
+import {ACTORS,identityToken} from './fixtures.mjs';
+import {createMappings} from './mappings.mjs';
+import {contractFor} from './adapter.mjs';
+import {CALLBACK_SOURCE_CONTRACT,callbackSourceTokenRequest,validateCallbackSourceReply} from './callback-source-contract.mjs';
+const options={httpStatus:200,localOrigin:'http://127.0.0.1:19104'};
+
+test('all actor sources use the strict existing password grant without performing I/O',()=>{
+ for(const id of Object.keys(ACTORS)){
+  const r=callbackSourceTokenRequest(id);assert.equal(contractFor(r.url,r.method).id,'identity');
+  assert.deepEqual(Object.fromEntries(new URLSearchParams(r.body)),{grant_type:'password',username:ACTORS[id].email,password:'fixture-password'});
+  assert.equal(r.headers['content-type'],'application/x-www-form-urlencoded');assert.ok(Object.isFrozen(r));
+ }
+ assert.throws(()=>callbackSourceTokenRequest('real-person'),/Unknown synthetic actor/);
+});
+test('exact native actor/token pairs accepted with explicit non-acceptance boundaries',()=>{
+ for(const id of Object.keys(ACTORS)){
+  const r=validateCallbackSourceReply(id,identityToken(id),options);assert.deepEqual(r.tokenFields,identityToken(id));
+  assert.equal(r.currentSessionVerified,false);assert.equal(r.providerAcceptance,false);assert.equal(r.consent,'unknown');assert.equal(r.callbackEndpointStatus,501);assert.ok(Object.isFrozen(r.tokenFields));
+ }
+});
+test('failed grants, mixed actors, altered lifetimes and invented consent/callback fields rejected',()=>{
+ for(const status of [400,401,403,500,502])assert.throws(()=>validateCallbackSourceReply('alice',identityToken('alice'),{...options,httpStatus:status}),/Successful native/);
+ for(const reply of [identityToken('admin'),{...identityToken('alice'),refresh_token:ACTORS.bob.refreshToken},{...identityToken('alice'),expires_in:86400}])assert.throws(()=>validateCallbackSourceReply('alice',reply,options),/mismatch/);
+ for(const name of ['state','nonce','provider','redirect_uri','consent','accessToken','id_token'])assert.throws(()=>validateCallbackSourceReply('alice',{...identityToken('alice'),[name]:'invented'},options),/Unsupported or ambiguous/);
+ const missing=identityToken('alice');delete missing.refresh_token;assert.throws(()=>validateCallbackSourceReply('alice',missing,options),/Unsupported or ambiguous/);
+});
+test('external/credentialed/path/query callback destinations cannot become redirect targets',()=>{
+ for(const localOrigin of ['https://accounts.google.com:443','http://localhost:19104','http://127.0.0.1','http://user@127.0.0.1:19104','http://127.0.0.1:19104/callback','http://127.0.0.1:19104/?redirect=https://example.com'])assert.throws(()=>validateCallbackSourceReply('alice',identityToken('alice'),{...options,localOrigin}));
+});
+test('existing native authorize/callback defaults remain 501 for every scenario',()=>{
+ const routes=createMappings().filter(m=>/^identity-(authorize|callback)-/.test(m.name||''));assert.equal(routes.length,14);assert.ok(routes.every(r=>r.response.status===501));
+ assert.equal(CALLBACK_SOURCE_CONTRACT.providerAcceptance,false);assert.ok(Object.isFrozen(CALLBACK_SOURCE_CONTRACT.fragmentAllowedKeys));
+});
