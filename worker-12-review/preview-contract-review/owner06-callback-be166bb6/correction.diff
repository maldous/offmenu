- if(Object.keys(reply).length!==NATIVE_KEYS.length||Object.keys(reply).some(k=>!NATIVE_KEYS.includes(k)))throw Error('Unsupported or ambiguous native token fields');
+export function validateCallbackSourceReply(actorId,reply,options){
+ // Actor binding must precede lookup/reflection/coercion of any other input.
+ actor(actorId);
+ const metadata=ownDataSnapshot(options,['httpStatus','localOrigin'],'Callback metadata');
+ if(metadata.httpStatus!==200)throw Error('Successful native token response required');
+ if(typeof metadata.localOrigin!=='string')throw Error('Primitive loopback origin required');
+ const origin=loopbackOrigin(metadata.localOrigin);
+ const captured=ownDataSnapshot(reply,NATIVE_KEYS,'Native token');
  const expected=identityToken(actorId);
- for(const key of NATIVE_KEYS)if(reply[key]!==expected[key])throw Error('Native synthetic token/actor/lifetime mismatch');
+ for(const key of NATIVE_KEYS)if(captured[key]!==expected[key])throw Error('Native synthetic token/actor/lifetime mismatch');
  return Object.freeze({schema:CALLBACK_SOURCE_CONTRACT.schema,actorId,localOrigin:origin,
-  tokenFields:Object.freeze(Object.fromEntries(NATIVE_KEYS.map(k=>[k,reply[k]]))),
+  tokenFields:Object.freeze(Object.fromEntries(NATIVE_KEYS.map(k=>[k,captured[k]]))),
   intentVerification:'Must be performed and consumed by Worker04 before SDK handling',
