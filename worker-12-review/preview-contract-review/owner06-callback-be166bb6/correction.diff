 // Local SDK callback INPUT contract only. No redirect, browser intent storage,
 // HTTP listener, state/nonce verification, provider consent or session creation.
 import {ACTORS,identityToken} from './fixtures.mjs';
+import {types} from 'node:util';
 import {loopbackOrigin} from './adapter.mjs';
 
 export const CALLBACK_SOURCE_CONTRACT=Object.freeze({
@@ -17,7 +18,23 @@ export const CALLBACK_SOURCE_CONTRACT=Object.freeze({
  unsupportedBridges:Object.freeze(['Google provider authorize/callback remains 501','browser extension/native bridge contract not agreed','device/health bridges are not HTTP mocks']),
 });
 const NATIVE_KEYS=Object.freeze(['access_token','refresh_token','token_type','expires_in']);
-function actor(id){if(!Object.hasOwn(ACTORS,id))throw Error('Unknown synthetic actor');return ACTORS[id];}
+function actor(id){if(typeof id!=='string'||!Object.hasOwn(ACTORS,id))throw Error('Unknown synthetic actor');return ACTORS[id];}
+
+// Node fixture boundary: property descriptors inspect ordinary records without
+// evaluating accessors. Reject proxies before reflection so their traps cannot
+// execute, and require exactly the named enumerable own data properties.
+function ownDataSnapshot(value,keys,label){
+ if(!value||typeof value!=='object'||types.isProxy(value)||Array.isArray(value))throw Error(label+' object required');
+ const descriptors=Object.getOwnPropertyDescriptors(value),names=Reflect.ownKeys(descriptors);
+ if(names.length!==keys.length||names.some(k=>typeof k!=='string'||!keys.includes(k)))throw Error('Unsupported or ambiguous '+label.toLowerCase()+' fields');
+ const captured=Object.create(null);
+ for(const key of keys){
+  const d=descriptors[key];
+  if(!d||!Object.hasOwn(d,'value')||!d.enumerable)throw Error(label+' requires enumerable own data fields');
+  captured[key]=d.value;
+ }
+ return Object.freeze(captured);
+}
 
