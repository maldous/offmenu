  const routes=createMappings().filter(m=>/^identity-(authorize|callback)-/.test(m.name||''));assert.equal(routes.length,14);assert.ok(routes.every(r=>r.response.status===501));
  assert.equal(CALLBACK_SOURCE_CONTRACT.providerAcceptance,false);assert.ok(Object.isFrozen(CALLBACK_SOURCE_CONTRACT.fragmentAllowedKeys));
 });
+
+test('C12-01 rejects accessor replies without invoking getters or returning unchecked fields',()=>{
+ for(const key of ['expires_in','access_token']){
+  let reads=0;const reply=identityToken('alice');
+  Object.defineProperty(reply,key,{enumerable:true,get(){reads++;return key==='expires_in'?(reads===1?3600:86400):(reads===1?ACTORS.alice.token:ACTORS.bob.token);}});
+  assert.throws(()=>validateCallbackSourceReply('alice',reply,options));assert.equal(reads,0);
+ }
+});
+test('C12-02 both exports reject coercible/boxed actors without running identity hooks',()=>{
+ let coercions=0;const id={ [Symbol.toPrimitive](){return ++coercions===4?'bob':'alice';}};
+ const reply={...identityToken('alice'),refresh_token:ACTORS.bob.refreshToken};
+ assert.throws(()=>validateCallbackSourceReply(id,reply,options));assert.throws(()=>callbackSourceTokenRequest(id));assert.equal(coercions,0);
+ for(const id of [new String('alice'),['alice'],null,()=> 'alice',Symbol('alice')]){
+  assert.throws(()=>callbackSourceTokenRequest(id));assert.throws(()=>validateCallbackSourceReply(id,identityToken('alice'),options));
+ }
+});
+test('strict own-data snapshots reject proxies/hidden fields and allow native null-prototype records',()=>{
+ let traps=0;const proxy=new Proxy(identityToken('alice'),{ownKeys(target){traps++;return Reflect.ownKeys(target);},get(target,key){traps++;return target[key];},getOwnPropertyDescriptor(target,key){traps++;return Object.getOwnPropertyDescriptor(target,key);}});
+ assert.throws(()=>validateCallbackSourceReply('alice',proxy,options));assert.equal(traps,0);
+ for(const key of ['nonce',Symbol('hidden')]){const reply=identityToken('alice');Object.defineProperty(reply,key,{value:'hidden',enumerable:false});assert.throws(()=>validateCallbackSourceReply('alice',reply,options));}
+ const reply=Object.assign(Object.create(null),identityToken('alice'));const r=validateCallbackSourceReply('alice',reply,options);reply.expires_in=86400;reply.access_token=ACTORS.bob.token;assert.deepEqual(r.tokenFields,identityToken('alice'));
+});
+test('metadata accessors and coercible origins cannot run hooks at the same input boundary',()=>{
+ let hooks=0;const metadata={localOrigin:options.localOrigin};Object.defineProperty(metadata,'httpStatus',{enumerable:true,get(){hooks++;return 200;}});
+ assert.throws(()=>validateCallbackSourceReply('alice',identityToken('alice'),metadata));assert.equal(hooks,0);
+ const localOrigin={toString(){hooks++;return options.localOrigin;}};assert.throws(()=>validateCallbackSourceReply('alice',identityToken('alice'),{httpStatus:200,localOrigin}));assert.equal(hooks,0);
+});
