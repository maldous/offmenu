+
+test('reordered scope acknowledges both transport and explicit reconciliation', async () => {
+  const reordered = {grantId: alice.grantId, resourceId: alice.resourceId, accountId: alice.accountId};
+  const f = fixture(), q = f.queue({transport: {idempotent: true, async send(envelope) {
+    return {...ack(envelope), scope: reordered};
+  }}});
+  await q.enqueue(operation); assert.equal((await q.flush()).status, 'acknowledged');
+  assert.equal((await q.flush()).status, 'idle');
+  const second = f.queue({scope: bob}); await second.enqueue(operation);
+  await second.acknowledge({acknowledged: true, operationId: operation.operationId,
+    scope: {grantId: bob.grantId, resourceId: bob.resourceId, accountId: bob.accountId}});
+  assert.equal((await second.flush()).status, 'idle');
+});
+
+test('scope mismatches and extra identity fields cannot acknowledge or reconcile', async () => {
+  for (const scope of [{...alice, accountId: 'other'}, {...alice, resourceId: 'other'},
+    {...alice, grantId: 'other'}, {...alice, extra: 'unexpected'}]) {
+    const f = fixture(), response = {acknowledged: true, operationId: operation.operationId, scope};
+    const q = f.queue({transport: {idempotent: true, async send() { return response; }}});
+    await q.enqueue(operation); assert.equal((await q.flush()).status, 'unknown');
+    await assert.rejects(q.acknowledge(response), /mismatch/);
+  }
+});
+
+test('hidden serialization hooks and accessors are rejected without being executed', () => {
+  const f = fixture(); let calls = 0;
+  const hidden = {deduct: 2};
+  Object.defineProperty(hidden, 'toJSON', {value() { calls++; return {deduct: 999}; }});
+  const accessor = {};
+  Object.defineProperty(accessor, 'deduct', {enumerable: true, get() { return ++calls === 1 ? 2 : 999; }});
+  for (const payload of [hidden, accessor, {nested: hidden}, [accessor]])
+    assert.throws(() => f.queue().enqueue({...operation, payload}), /JSON/);
+  assert.equal(calls, 0); assert.equal(f.records.size, 0);
+});
+
+test('fresh JSON capture preserves benign fields and rejects cycles, custom prototypes and sparse arrays', async () => {
+  const f = fixture(), q = f.queue(), payload = JSON.parse('{"__proto__":{"deduct":2},"constructor":"food","toJSON":"label","items":[null,true,2,"rice"]}');
+  await q.enqueue({...operation, payload});
+  assert.deepEqual((await q.inspect()).operations[0].payload, payload);
+  const cycle = {}; cycle.self = cycle;
+  const inherited = Object.create({toJSON() { return {deduct: 999}; }}); inherited.deduct = 2;
+  for (const value of [cycle, inherited, new Array(1), {fn() {}}, {[Symbol('hidden')]: 2}])
+    assert.throws(() => q.enqueue({...operation, operationId: 'other', payload: value}), /JSON/);
+});
