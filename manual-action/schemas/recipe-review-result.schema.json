{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:offmenu:recipe-menu-review-result:1",
  "title": "One actual assistant review receipt for one rule artifact",
  "description": "Actual native-assistant output, not generated by rules. Core validation plus recipe template validation required; schemas cannot authenticate a reviewer or prove semantic correctness. Synthetic fixture receipts are not corpus review.",
  "type": "object",
  "properties": {
    "artifact_id": {
      "type": "string"
    },
    "artifact_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "receipt_id": {
      "type": "string"
    },
    "reviewer_id": {
      "type": "string"
    },
    "reviewer_kind": {
      "const": "assistant"
    },
    "model_version": {
      "type": "string"
    },
    "prompt_version": {
      "type": "string"
    },
    "schema_version": {
      "type": "string"
    },
    "template_version": {
      "type": "string"
    },
    "reviewed_at": {
      "type": "string",
      "format": "date-time"
    },
    "method": {
      "const": "direct_item_review"
    },
    "evidence_ref": {
      "type": "string"
    },
    "decision": {
      "enum": [
        "accepted",
        "needs_changes",
        "rejected"
      ]
    },
    "normalized": {
      "type": "object",
      "properties": {
        "title": {
          "type": [
            "string",
            "null"
          ]
        },
        "language": {
          "type": [
            "string",
            "null"
          ]
        },
        "fields": {
          "type": "object",
          "properties": {
            "recipe_menu_template": {
              "$ref": "urn:offmenu:recipe-menu-template:1"
            },
            "translation_plan": {
              "type": "object"
            }
          },
          "required": [
            "recipe_menu_template",
            "translation_plan"
          ],
          "additionalProperties": false
        },
        "relations": {
          "type": "array",
          "items": {
            "type": "object"
          }
        },
        "field_lineage": {
          "type": "array",
          "items": {
            "type": "object"
          }
        }
      },
      "required": [
        "title",
        "language",
        "fields",
        "relations",
        "field_lineage"
      ],
      "additionalProperties": false
    },
    "coverage": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "item_id": {
            "type": "string"
          },
          "decision": {
            "enum": [
              "accepted",
              "needs_changes",
              "rejected"
            ]
          },
          "notes": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "item_id",
          "decision",
          "notes"
        ],
        "additionalProperties": false
      }
    },
    "issues": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "code": {
            "type": "string"
          },
          "severity": {
            "enum": [
              "warning",
              "error"
            ]
          },
          "path": {
            "type": "string"
          },
          "detail": {
            "type": "string"
          }
        },
        "required": [
          "code",
          "severity",
          "path",
          "detail"
        ],
        "additionalProperties": false
      }
    },
    "uncertainty": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "reuse_of_artifact_id": {
      "type": "string",
      "minLength": 1
    }
  },
  "required": [
    "artifact_id",
    "artifact_sha256",
    "receipt_id",
    "reviewer_id",
    "reviewer_kind",
    "model_version",
    "prompt_version",
    "schema_version",
    "template_version",
    "reviewed_at",
    "method",
    "evidence_ref",
    "decision",
    "normalized",
    "coverage",
    "issues",
    "uncertainty"
  ],
  "additionalProperties": false
}
