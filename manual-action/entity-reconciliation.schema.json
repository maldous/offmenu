      "type": "object",
      "properties": {
        "entity_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2048,
          "pattern": "\\S"
        },
        "domain": {
          "enum": [
            "barcodes",
            "ingredients",
            "recipes",
            "dietary",
            "suppliers",
            "citations",
            "user_profiles",
            "inventory"
          ]
        },
        "entity_type": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2048,
          "pattern": "\\S"
        },
        "household_scope": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 2048,
              "pattern": "\\S"
            },
            {
              "type": "null"
            }
          ]
        },
        "user_scope": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 2048,
              "pattern": "\\S"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "entity_id",
        "domain",
        "entity_type",
        "household_scope",
        "user_scope"
      ],
      "additionalProperties": false
    },
    "Source": {
      "type": "object",
      "properties": {
        "domain": {
          "enum": [
            "barcodes",
            "ingredients",
            "recipes",
            "dietary",
            "suppliers",
            "citations",
            "user_profiles",
            "inventory"
          ]
        },
        "source_key": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2048,
          "pattern": "\\S"
        },
        "source_version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2048,
          "pattern": "\\S"
        },
        "record_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2048,
          "pattern": "\\S"
        },
        "content_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "adapter_occurrence_id": {
          "anyOf": [
            {
