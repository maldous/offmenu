              "minLength": 1,
              "maxLength": 2048,
              "pattern": "\\S"
            },
            {
              "type": "null"
            }
          ]
        },
        "physical_representation_id": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 2048,
              "pattern": "\\S"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "domain",
        "source_key",
        "source_version",
        "record_id",
        "content_sha256",
        "adapter_occurrence_id",
        "physical_representation_id"
      ],
      "additionalProperties": false
    },
    "Identifier": {
      "type": "object",
      "properties": {
        "namespace": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2048,
          "pattern": "\\S"
        },
        "provider": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2048,
          "pattern": "\\S"
        },
        "value_type": {
          "enum": [
            "string",
            "integer"
          ]
        },
        "lexical_value": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2048,
          "pattern": "\\S"
        }
      },
      "required": [
        "namespace",
        "provider",
        "value_type",
        "lexical_value"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "value_type": {
                "const": "integer"
              }
            },
            "required": [
              "value_type"
            ]
          },
          "then": {
            "properties": {
              "lexical_value": {
                "pattern": "^[+-]?[0-9]+$"
              }
            }
          }
        }
      ]
    },
    "Occurrence": {
      "type": "object",
