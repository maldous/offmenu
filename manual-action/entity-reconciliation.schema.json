            {
              "type": "null"
            }
          ]
        },
        "identifiers": {
          "type": "array",
          "items": {},
          "maxItems": 200000
        },
        "raw": {}
      },
      "required": [
        "occurrence_id",
        "source",
        "entity_type",
        "household_scope",
        "user_scope",
        "identifiers",
        "raw"
      ],
      "additionalProperties": false
    },
