# Documentation only: no settings are activated by this file.
# DB is a deployment-owned D1 binding, not a string to populate here.
# PROVIDER_VAULT_KEY: preserve/provision through the existing deployment secret store; no value here.
# CURATED_CORPUS_ORIGIN=<accepted-public-static-origin>  # only after publication acceptance
# OFFMENU_CURATED_RELEASE=<accepted-local-release-directory>  # publication-tool input only
# OFFMENU_AUTH_MODE=netlify  # missing mode also preserves legacy verifier; no auth migration
# BETTER_AUTH_URL=<explicit-https-origin>  # optional, requires trusted explicit authOptions policy
# BETTER_AUTH_SECRET: separately provisioned optional deployment secret; no value here.
