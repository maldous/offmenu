+            self.assertTrue(db.in_transaction)
+            self.assertEqual(db.execute('SELECT COUNT(*) FROM artifacts').fetchone()[0], 1)
+            self.assertEqual(result['new'], 1)
+            db.execute('INSERT INTO owner_checkpoint VALUES(?,?)', ('key-a', 1))
