{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:offmenu:delivery-handoff:1",
  "title": "OffMenu native-platform handoff v1",
  "description": "Source/evidence shape only; not authority, runtime success, independent acceptance, dispatch or a migration of legacy receipts. Use native_harness_contract for bounded policy and cross-field checks.",
  "type": "object",
  "properties": {
    "version": {
      "type": "integer",
      "const": 1
    },
    "kind": {
      "const": "delivery-handoff-v1"
    },
    "issue_id": {
      "$ref": "#/$defs/uuid"
    },
    "project_id": {
      "$ref": "#/$defs/uuid"
    },
    "owner": {
      "$ref": "#/$defs/text"
    },
    "origin": {
      "$ref": "#/$defs/origin"
    },
    "source": {
      "$ref": "#/$defs/source"
    },
    "outputs": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/ref"
      },
      "minItems": 0,
      "maxItems": 128,
      "uniqueItems": true
    },
    "evidence": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/ref"
      },
      "minItems": 1,
      "maxItems": 64,
      "uniqueItems": true
    },
    "attempt": {
      "$ref": "#/$defs/attempt"
    },
    "operation": {
      "$ref": "#/$defs/operation"
    },
    "review": {
      "$ref": "#/$defs/review"
    },
    "effect": {
      "$ref": "#/$defs/effect"
    }
  },
  "required": [
    "version",
    "kind",
    "issue_id",
    "project_id",
    "owner",
    "origin",
    "source",
    "outputs",
    "evidence"
  ],
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "origin": {
            "properties": {
              "kind": {
                "enum": [
                  "reviewed-source-v1",
                  "reviewed-extraction-v1",
                  "native-readonly-review-v1"
                ]
              }
            }
          }
        }
      },
      "then": {
        "not": {
          "required": [
            "attempt"
          ]
        }
      }
    },
    {
      "if": {
        "required": [
          "effect"
        ]
      },
      "then": {
        "required": [
          "operation"
        ]
      }
    }
  ],
  "$defs": {
    "text": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200,
      "pattern": "^[^\\x00-\\x1f\\x7f]+$"
    },
    "sha256": {
      "type": "string",
      "minLength": 64,
      "maxLength": 64,
      "pattern": "^[0-9a-f]{64}$"
    },
    "uuid": {
      "type": "string",
      "minLength": 36,
      "maxLength": 36,
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "ref": {
      "type": "object",
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024,
          "description": "Canonical local absolute or relative path; no URI, dot segments, controls or backslash. Validators never follow evidence references."
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        }
      },
      "required": [
        "path",
        "sha256"
      ],
      "additionalProperties": false
    },
    "source": {
      "type": "object",
      "properties": {
        "repository": {
          "const": "maldous/offmenu"
        },
        "branch": {
          "type": "string",
          "minLength": 1,
          "maxLength": 168
        },
        "base": {
          "type": "string",
          "minLength": 40,
          "maxLength": 40,
          "pattern": "^[0-9a-f]{40}$"
        },
        "head": {
          "type": "string",
          "minLength": 40,
          "maxLength": 40,
          "pattern": "^[0-9a-f]{40}$"
        },
        "tree": {
          "type": "string",
          "minLength": 40,
          "maxLength": 40,
          "pattern": "^[0-9a-f]{40}$"
        },
        "target": {
          "enum": [
            "develop",
            "main"
          ]
        },
        "policy_sha256": {
          "$ref": "#/$defs/sha256"
        }
      },
      "required": [
        "repository",
        "branch",
        "base",
        "head",
        "tree",
        "target",
        "policy_sha256"
      ],
      "additionalProperties": false
    },
    "origin": {
      "type": "object",
      "properties": {
        "kind": {
          "enum": [
            "native-coding-v1",
            "reviewed-source-v1",
            "reviewed-extraction-v1",
            "completed-native-validation-v1",
            "native-readonly-review-v1"
          ]
        },
        "evidence": {
          "$ref": "#/$defs/ref"
        }
      },
      "required": [
        "kind",
        "evidence"
      ],
      "additionalProperties": false
    },
    "attempt": {
      "type": "object",
      "properties": {
        "id": {
          "$ref": "#/$defs/text"
        },
        "lease_id": {
          "$ref": "#/$defs/text"
        },
        "admission": {
          "$ref": "#/$defs/ref"
        }
      },
      "required": [
        "id",
        "lease_id",
        "admission"
      ],
      "additionalProperties": false
    },
    "operation": {
      "type": "object",
      "properties": {
        "id": {
          "$ref": "#/$defs/text"
        },
        "backend": {
          "enum": [
            "windmill",
            "github",
            "langgraph",
            "stokowski"
          ]
        },
        "job_id": {
          "$ref": "#/$defs/text"
        },
        "status": {
          "enum": [
            "planned",
            "submitted",
            "running",
            "succeeded",
            "failed",
            "unknown",
            "cancelled"
          ]
        },
        "command_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "runner_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "policy_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "receipt": {
          "$ref": "#/$defs/ref"
        }
      },
      "required": [
        "id",
        "backend",
        "job_id",
        "status",
        "command_sha256",
        "runner_sha256",
        "policy_sha256",
        "receipt"
      ],
      "additionalProperties": false
    },
    "review": {
      "type": "object",
      "properties": {
        "reviewer": {
          "$ref": "#/$defs/text"
        },
        "author": {
          "$ref": "#/$defs/text"
        },
        "verdict": {
          "enum": [
            "accept",
            "changes-requested"
          ]
        },
        "source_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "outputs_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "evidence": {
          "$ref": "#/$defs/ref"
        }
      },
      "required": [
        "reviewer",
        "author",
        "verdict",
        "source_sha256",
        "outputs_sha256",
        "evidence"
      ],
      "additionalProperties": false
    },
    "effect": {
      "type": "object",
      "properties": {
        "operation_id": {
          "$ref": "#/$defs/text"
        },
        "status": {
          "enum": [
            "not-attempted",
            "pending",
            "unknown",
            "verified",
            "failed"
          ]
        },
        "reconciliation": {
          "$ref": "#/$defs/ref"
        }
      },
      "required": [
        "operation_id",
        "status"
      ],
      "additionalProperties": false
    },
    "releaseCandidate": {
      "type": "object",
      "properties": {
        "version": {
          "type": "integer",
          "const": 1
        },
        "kind": {
          "const": "release-candidate-v1"
        },
        "source": {
          "$ref": "#/$defs/source"
        },
        "required_profiles": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/text"
          },
          "minItems": 1,
          "maxItems": 32,
          "uniqueItems": true
        },
        "artifacts": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ref"
          },
          "minItems": 1,
          "maxItems": 128,
          "uniqueItems": true
        }
      },
      "required": [
        "version",
        "kind",
        "source",
        "required_profiles",
        "artifacts"
      ],
      "additionalProperties": false
    }
  }
}
