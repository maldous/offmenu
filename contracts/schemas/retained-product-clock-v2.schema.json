{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Opt-in retained product clock overlay; combine with full source schemas",
  "type": "object",
  "required": ["provenance"],
  "properties": {
    "provenance": {
      "type": "object",
      "required": ["sourceId", "releaseId", "fetchedAt"],
      "properties": {
        "acquisitionClock": {
          "type": "object",
          "additionalProperties": false,
          "required": ["status", "evidenceSha256"],
          "properties": {
            "status": {"const": "unknown-retained"},
            "evidenceSha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
          }
        }
      },
      "if": {"required": ["acquisitionClock"]},
      "then": {"properties": {
        "fetchedAt": {"type": "null"},
        "sourceId": {"enum": ["off", "usda-files"]}
      }},
      "else": {"properties": {"fetchedAt": {
        "type": "string", "pattern": "^.+T.+(Z|[+-][0-9]{2}:[0-9]{2})$"
      }}}
    }
  }
}
