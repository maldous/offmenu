{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:offmenu:media-preparation-contract:1",
  "title": "OffMenu bounded media preparation contract",
  "description": "Reviewed fixed caller binds exact local-original identity and independently evidenced preparation permissions. Contract does not authorize acquisition, normalization, translation or gold admission. Runtime validation additionally enforces pageStart<=pageEnd and format-specific required parameters.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "assetId",
    "expectedSHA256",
    "expectedBytes",
    "expectedMediaTypes",
    "permissions",
    "holds",
    "parameters"
  ],
  "properties": {
    "schemaVersion": {
      "const": "offmenu-media-preparation-contract/1"
    },
    "assetId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,191}$"
    },
    "expectedSHA256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "expectedBytes": {
      "type": "integer",
      "minimum": 1,
      "maximum": 1073741824
    },
    "expectedMediaTypes": {
      "type": "array",
      "minItems": 1,
      "maxItems": 8,
      "uniqueItems": true,
      "items": {
        "enum": [
          "application/gzip",
          "application/json",
          "application/msword",
          "application/octet-stream",
          "application/pdf",
          "application/vnd.apache.parquet",
          "application/vnd.ms-excel",
          "application/vnd.openxmlformats-officedocument.spreadsheetml.sheet",
          "application/vnd.openxmlformats-officedocument.wordprocessingml.document",
          "application/vnd.rar",
          "application/vnd.sqlite3",
          "application/x-7z-compressed",
          "application/x-bzip2",
          "application/x-xz",
          "application/xml",
          "application/zip",
          "text/csv",
          "text/html",
          "text/plain",
          "text/tab-separated-values"
        ]
      }
    },
    "permissions": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "read",
        "extract",
        "copy"
      ],
      "properties": {
        "read": {
          "type": "boolean"
        },
        "extract": {
          "type": "boolean"
        },
        "copy": {
          "type": "boolean"
        }
      }
    },
    "holds": {
      "type": "array",
      "maxItems": 4,
      "uniqueItems": true,
      "items": {
        "enum": [
          "read",
          "extract",
          "copy",
          "all"
        ]
      }
    },
    "parameters": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "encoding": {
          "enum": [
            "cp1252",
            "iso-8859-1",
            "utf-16",
            "utf-16-be",
            "utf-16-le",
            "utf-8",
            "utf-8-sig"
          ]
        },
        "delimiter": {
          "enum": [
            ",",
            ";",
            "\t",
            "|"
          ]
        },
        "hasHeader": {
          "type": "boolean"
        },
        "jsonRecordPath": {
          "type": "array",
          "maxItems": 16,
          "items": {
            "type": "string",
            "pattern": "^[A-Za-z_][A-Za-z0-9_.-]{0,127}$"
          }
        },
        "xmlRecordTag": {
          "type": "string",
          "pattern": "^[A-Za-z_][A-Za-z0-9_.-]{0,127}$"
        },
        "sheetIndexes": {
          "type": "array",
          "minItems": 1,
          "maxItems": 256,
          "uniqueItems": true,
          "items": {
            "type": "integer",
            "minimum": 0,
            "maximum": 255
          }
        },
        "pageStart": {
          "type": "integer",
          "minimum": 1,
          "maximum": 2000
        },
        "pageEnd": {
          "type": "integer",
          "minimum": 1,
          "maximum": 2000
        }
      }
    }
  }
}
