      "required": [
        "title",
        "servings",
        "source",
        "license",
        "ingredients",
        "instructions"
      ],
      "additionalProperties": false
    },
    "profile": {
      "type": "object",
      "properties": {
        "schema_version": {
          "const": "offmenu-household-profile/1"
        },
        "display_name": {
          "type": "string",
          "maxLength": 100,
          "minLength": 1
        },
        "age_years": {
          "anyOf": [
            {
              "type": "number",
              "minimum": 0,
              "maximum": 9000000000
