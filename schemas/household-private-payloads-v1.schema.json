                "end": {
                  "type": "string",
                  "format": "date-time"
                },
                "time_zone": {
                  "type": "string",
                  "maxLength": 100,
                  "minLength": 1
                }
              },
              "required": [
                "start",
                "end",
                "time_zone"
              ],
              "additionalProperties": false
            },
            {
              "type": "null"
