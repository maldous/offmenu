                "weekdays": {
                  "type": "array",
                  "items": {
                    "enum": [
                      "MO",
                      "TU",
                      "WE",
                      "TH",
                      "FR",
                      "SA",
                      "SU"
                    ]
                  },
                  "maxItems": 7,
                  "uniqueItems": true
                },
                "until_date": {
                  "anyOf": [
                    {
                      "type": "null"
                    },
                    {
                      "type": "string",
                      "format": "date"
                    }
                  ]
                }
              },
              "required": [
                "frequency",
                "interval",
                "weekdays",
                "until_date"
              ],
              "additionalProperties": false
            }
          ]
        }
      },
      "required": [
        "schema_version",
        "kind",
        "label",
        "status",
        "home_ids",
        "source",
        "qualifiers",
        "window"
