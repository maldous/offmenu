      "additionalProperties": false
    },
    "quantity": {
      "type": "object",
      "properties": {
        "value_decimal": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^(0|[1-9][0-9]*)(\\.[0-9]+)?$",
              "maxLength": 100
            },
            {
              "type": "null"
            }
          ]
        },
        "unit": {
          "anyOf": [
            {
              "type": "string",
              "maxLength": 50,
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "original_text": {
          "anyOf": [
            {
              "type": "string",
              "maxLength": 1000,
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "basis": {
          "enum": [
            "original",
            "edible",
            "drained",
            "prepared",
            "serving",
            "pack",
            "unknown"
          ]
        },
        "status": {
          "enum": [
            "measured",
            "declared",
            "estimated",
            "unknown"
          ]
        }
      },
      "required": [
        "value_decimal",
        "unit",
        "original_text",
        "basis",
        "status"
      ],
      "additionalProperties": false
    },
    "money": {
      "type": "object",
      "properties": {
        "amount_decimal": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]*)(\\.[0-9]+)?$",
          "maxLength": 50
        },
        "currency": {
          "type": "string",
          "pattern": "^[A-Z]{3}$"
        },
        "observed_at": {
          "type": "string",
          "format": "date-time"
        },
        "basis": {
          "enum": [
            "pack",
            "unit",
            "consumed",
            "fee",
            "tax",
            "discount"
          ]
        },
        "source": {
          "$ref": "#/$defs/source"
        }
      },
      "required": [
        "amount_decimal",
        "currency",
        "observed_at",
        "basis",
        "source"
      ],
      "additionalProperties": false
    },
    "identifier": {
      "type": "object",
      "properties": {
        "scheme": {
          "type": "string",
          "maxLength": 80,
          "minLength": 1
        },
        "namespace": {
          "type": "string",
          "maxLength": 200,
          "minLength": 1
        },
        "value": {
          "type": "string",
          "maxLength": 300,
          "minLength": 1
        },
        "validation_status": {
          "enum": [
            "valid",
            "invalid",
            "unverified",
            "unsupported"
          ]
        }
      },
      "required": [
        "scheme",
        "namespace",
        "value",
        "validation_status"
      ],
      "additionalProperties": false
    },
    "nutrient": {
      "type": "object",
      "properties": {
        "metric": {
          "type": "string",
          "maxLength": 100,
          "minLength": 1
        },
        "definition": {
          "type": "string",
          "maxLength": 200,
          "minLength": 1
        },
        "quantity": {
          "$ref": "#/$defs/quantity"
        },
        "basis_quantity": {
          "$ref": "#/$defs/quantity"
        },
        "known": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9000000000000000
        },
        "total": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9000000000000000
        },
        "source": {
          "$ref": "#/$defs/source"
        }
      },
      "required": [
        "metric",
        "definition",
        "quantity",
        "basis_quantity",
        "known",
        "total",
        "source"
      ],
      "additionalProperties": false
    },
    "recipe": {
      "type": "object",
      "properties": {
        "title": {
          "type": "string",
          "maxLength": 500,
          "minLength": 1
        },
        "servings": {
          "type": "number",
          "minimum": 1e-06,
          "maximum": 9000000000
        },
        "source": {
          "$ref": "#/$defs/source"
        },
        "license": {
          "type": "string",
          "maxLength": 300,
          "minLength": 1
        },
        "ingredients": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "raw": {
                "type": "string",
                "maxLength": 2000,
                "minLength": 1
              },
              "ingredient": {
                "anyOf": [
                  {
                    "type": "string",
                    "maxLength": 300,
                    "minLength": 1
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "quantity": {
                "$ref": "#/$defs/quantity"
              },
              "optional": {
                "type": "boolean"
              },
              "mapping_status": {
                "enum": [
                  "unresolved",
                  "candidate",
                  "verified",
                  "conflict"
                ]
              }
            },
            "required": [
              "raw",
              "ingredient",
              "quantity",
              "optional",
              "mapping_status"
            ],
            "additionalProperties": false
          },
          "maxItems": 1000
