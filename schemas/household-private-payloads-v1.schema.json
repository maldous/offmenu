            {
              "type": "object",
              "properties": {
                "frequency": {
                  "enum": [
                    "once",
                    "daily",
                    "weekly"
                  ]
                },
                "interval": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 52
