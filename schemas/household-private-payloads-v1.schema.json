    },
    {
      "$ref": "#/$defs/location"
    },
    {
      "$ref": "#/$defs/item"
    },
    {
      "$ref": "#/$defs/mapping"
    },
    {
      "$ref": "#/$defs/receipt"
    },
    {
      "$ref": "#/$defs/receipt_line"
    },
    {
      "$ref": "#/$defs/plan"
    },
    {
      "$ref": "#/$defs/meal"
    },
    {
      "$ref": "#/$defs/attendance"
    },
    {
      "$ref": "#/$defs/cook_batch"
    },
    {
      "$ref": "#/$defs/lot"
