      "old": "import {planSummary,weekDates} from './menu-model.js';",
      "new": "import {planSummary,weekDates} from './menu-model.js';\nimport {measuredIngredient} from './ingredients.js';"
    },
    {
      "old": "plan.flatMap(p=>(recipes.find(r=>r.id===p.recipeId)?.ingredients||[]).filter(i=>!i.optional&&(i.quantity==null||!i.unit)).map(i=>i.raw||i.ingredient))",
      "new": "plan.flatMap(p=>{const recipe=recipes.find(r=>r.id===p.recipeId);if(!recipe)return [];const demandKnown=!recipe.needsReview&&!recipe.servingsUnknown&&Number.isFinite(recipe.servings)&&recipe.servings>0&&Number.isFinite(p.servings)&&p.servings>0;return (recipe.ingredients||[]).filter(i=>!i.optional&&(!demandKnown||!measuredIngredient(i))).map(i=>i.raw||i.ingredient);})"
    }
  ]
