+        self.assertEqual(t.calls[-1][1]['If-None-Match'], 'version')
+        self.assertEqual(result['sources'][0]['provenance']['originalAcquiredAt'], NOW.isoformat())
+        self.assertEqual(result['network']['bodyBytesRead'], 0)
