export const id=15;export const durationMs=5400;export const reference={"width":1047,"height":663,"source":{"path":"/home/user/src/offmenu-data/runtime/layout-migration/worker05/native-browser-kitchen-15-20261026/v4-keyframe-world/targets/target-15.png","sha256":"1ccece3603bb79b19f8650db04b4b9abb88b716445d1eda51d610c8b421e27c7"},"anchors":{"neck":null,"shoulder":null,"elbow":null,"wrist":null,"index":null,"grip":[308,468],"support":null,"armCropRoot":[460,715],"propBase":null,"tabletGlass":[[456,324],[738,294],[798,525],[495,567]]},"anchorReasons":{"neck":"Cropped/obscured no verified R4 semantic point","shoulder":"Clothed/partly cropped not inferred","elbow":"Offcrop not invented","wrist":"R4 supplies grasp/root reference only, not verified anatomy","index":"Pinch/grip not tablet tap","support":"Held lowered receipt, no qualified support point or release in source-local action","propBase":"Concealed/held receipt; master physical support/release remains open"},"materialCandidates":"Concealed receipt4652(blank paper,no inferred text/barcode),bag2694,carton2 source-onlyfills; visibleRGBAunchanged,inference not source/nativeacceptance."};
const root=[460,715],grip=[308,468],mesh=grid(reference.width,reference.height,{root,index:grip});
export async function load({loadImage,resolveAsset}){const out={};for(const n of ['actorCore','receiptGripArm'])out[n]=await loadImage(resolveAsset('./assets/scene-15/'+n+'.png'));for(const n of ['printedReceipt','groceryBag','carton'])out[n]=await loadImage(resolveAsset('./assets/scene-15/'+n+'-complete.png'));out.screen=await loadImage(resolveAsset('./assets/scene-15/approved-screen.png'));return out;}
export function sample(p,assets){const pose=heldPose(p,{start:[-12,45,-.05],end:[8,60,.035]}),hand=attachedSkin(mesh,{root,grip,radius:130,width:reference.width,height:reference.height},pose),where=rigidPixel(grip,grip,pose);return{layers:[{id:'receipt-grocery-bag',image:assets.groceryBag,role:'prop',order:10},{id:'receipt-carton',image:assets.carton,role:'prop',order:11},{id:'receipt-held-paper',image:assets.printedReceipt,role:'prop',order:20,transform:{pivot:[grip[0]/reference.width,grip[1]/reference.height],angle:pose.angle,shift:[pose.shift[0]/reference.width,pose.shift[1]/reference.height]}},{id:'receipt-grip-arm',image:assets.receiptGripArm,role:'actor',order:30,rasterMesh:mesh,deformedUV:hand},{id:'receipt-actor-core',image:assets.actorCore,role:'foreground',order:40}],contacts:[{id:'receipt-paper-grip',layerId:'receipt-grip-arm',kind:'grip',point:where,target:'prop:receipt-held-paper',active:true,releaseSupported:false}],screen:assets.screen,phase:p===1?'settled':p>=.56&&p<=.74?'contact':'action'};}
