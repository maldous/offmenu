import * as base from '../scene-15.mjs';
import {sourceProgress,pointFollowThrough,heldInspection,bodyFollow} from './motion.mjs';
export const id=15;export const durationMs=3900;
export const reference={...base.reference,choreography:'R3 distinct anticipation/reach-or-raise/inspection/follow-through; incremental source-local candidate, not completed human/world animation'};
export function load(ctx){return base.load({...ctx,resolveAsset:path=>ctx.resolveAsset('../'+path.replace(/^\.\//,''))});}
export function sample(p,assets){const q=sourceProgress(id,p),frame=base.sample(q,assets);
 heldInspection(frame,id,p,reference);
 frame.choreographyProgress=p;return frame;}
