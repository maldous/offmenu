// Seated Consumption action. Source-specific bent-arm rig, not a room/clock.
export const id=9;
export const durationMs=3800;
const W=1047,H=624,root=[555,480],elbow=[606,558],wrist=[673,473],tip=[744,369];
export const reference={width:W,height:H,
 source:{path:'/home/user/src/offmenu-data/runtime/layout-migration/worker05/native-browser-kitchen-15-20261026/v4-keyframe-world/targets/target-09.png',sha256:'dc0b132e4deb8178dfc4cb0e4ce57b515030828eef1778e633eacf1495dc37cc'},
 anchors:{neck:null,shoulder:null,elbow,wrist,index:tip,grip:null,support:null,propBase:null,
  cuffRoot:root,tabletGlass:[[666,267],[900,282],[876,444],[630,426]]},
 anchorReasons:{neck:'Rear collar does not independently establish anatomical root.',shoulder:'Joint lies inside opaque shirt.',elbow:'Visible seated arm bend reference, approximately ±12 pixels; not surveyed joint.',wrist:'Observed palm/forearm taper ±10 pixels.',index:'Approved fingertip ±5 pixels.',grip:'No grasp or eating utensil in this scene.',support:'Meal plate/glass/chair remain fixed; physical support points not exposed.',propBase:'No moving prop.'},
 action:'Seated user reaches to the consumption control, contacts it once, withdraws the bent arm. No invented eating/fork or state mutation.'};
const clamp=x=>Math.max(0,Math.min(1,x)),smooth=x=>{x=clamp(x);return x*x*(3-2*x);};
function state(p){
 p=clamp(p);if(p<.18)return{elbow:.11,wrist:.10,phase:'action'};
 if(p<.6){const a=1-smooth((p-.18)/.42);return{elbow:.11*a,wrist:.10*a,phase:'action'};}
 if(p<=.72)return{elbow:0,wrist:0,phase:'contact'};
 const a=smooth((p-.72)/.28);return{elbow:.16*a,wrist:.14*a,phase:p<.98?'release':'settled'};
}
function turn([x,y],[cx,cy],a){const c=Math.cos(a),s=Math.sin(a);return[cx+(x-cx)*c-(y-cy)*s,cy+(x-cx)*s+(y-cy)*c];}
function deform([x,y],s){
 const local=smooth((x-445)/105)*smooth((855-x)/100)*smooth((y-280)/100);
 const distal=smooth((x-root[0])/90)*local;
 const a=turn([x,y],elbow,s.elbow*distal);
 const wp=turn(wrist,elbow,s.elbow*smooth((wrist[0]-root[0])/90));
 const hand=smooth((x-620)/65)*smooth((530-y)/70)*local;
 return turn(a,wp,s.wrist*hand);
}
// Exact measured root/index grid lines avoid an analytic/raster contact mismatch.
const xs=[...new Set([...Array.from({length:54},(_,i)=>i/53),root[0]/W,tip[0]/W])].sort((a,b)=>a-b);
const ys=[...new Set([...Array.from({length:36},(_,i)=>i/35),root[1]/H,tip[1]/H])].sort((a,b)=>a-b);
const source=ys.flatMap(v=>xs.map(u=>[u,v])),indices=[];
for(let y=0;y<ys.length-1;y++)for(let x=0;x<xs.length-1;x++){const k=y*xs.length+x;indices.push(k,k+xs.length,k+1,k+1,k+xs.length,k+xs.length+1);}
const rasterMesh={source,indices,root:[root[0]/W,root[1]/H],indexContact:[tip[0]/W,tip[1]/H]};
export async function load({loadImage,resolveAsset}){const names=['actorCore','pointArm','chair','mealPlate','glass','approved-screen'];const a=await Promise.all(names.map(n=>loadImage(resolveAsset(`./assets/${n==='actorCore'?'actorCore-cuff-r2':n}.png`))));return Object.fromEntries(names.map((n,i)=>[n,a[i]]));}
export function sample(progress,assets){const s=state(progress);return{
 layers:[
  {id:'consumption-chair',image:assets.chair,role:'prop',order:-5},
  {id:'consumption-seated-actor',image:assets.actorCore,role:'actor',order:0},
  {id:'consumption-meal',image:assets.mealPlate,role:'prop',order:5},
  {id:'consumption-glass',image:assets.glass,role:'prop',order:6},
  {id:'consumption-bent-arm',image:assets.pointArm,role:'actor',order:20,rasterMesh,
   deformedUV:source.map(([u,v])=>{const q=deform([u*W,v*H],s);return[q[0]/W,q[1]/H];})}
 ],contacts:[{id:'consumption-control',layerId:'consumption-bent-arm',kind:'tap',point:deform(tip,s),target:'tablet',active:s.phase==='contact',targetPoint:tip,targetGlassUV:[.4159352836524565,.6102697543256469]}],
 screen:assets['approved-screen'],phase:s.phase};}
export function dispose(){}
