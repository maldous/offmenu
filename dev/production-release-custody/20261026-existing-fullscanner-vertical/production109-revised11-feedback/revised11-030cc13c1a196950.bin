// Scene03 unpack: source-derived two-bone arm, attached leaf and weighted sleeve.
export const id=3,durationMs=3600;
export const reference={width:1047,height:627,source:{path:'/home/user/src/offmenu-data/runtime/layout-migration/worker05/native-browser-kitchen-15-20261026/v4-keyframe-world/targets/target-03.png',sha256:'62fe73a08cce5063846cd7e84bfa5781a90cd16a24b791325929d6dd61a9cfd8'},anchors:{neck:[420,250],shoulder:null,elbow:[233,382],wrist:[396,323],index:null,grip:[476.5,361.5],propBase:[494.5,536],propContact:[476.5,361.5],support:null,tabletGlass:[[40,451],[240,425],[277,552],[59,586]]},anchorQualification:{shoulder:'Anatomical centre concealed; internal source animation guide267,263 is an authoring control, not observed world joint.',index:'Closed grip; index tip individually concealed.',support:'No admitted empty worktop support point; earlier362,587 inside bag rejected. Leaf stays hand-supported.',tabletGlass:'Approximate hand-traced source screen interior; master owns actual fixed glass registration.'}};
const names=['core','upper-arm','forearm-hand','support-arm','joint-underlap','leaf','bag','bagRight','bag-contents','foreground'];
export async function load({loadImage,resolveAsset}){return Object.fromEntries(await Promise.all(names.map(async n=>[n,await loadImage(resolveAsset('./assets/scene-03/'+n+'.png'))])));}
const W=1047,H=627,root=[267,263],elbow0=[233,382],wrist0=[396,323],grip0=[476.5,361.5],base0=[494.5,536];
const smooth=x=>{x=Math.max(0,Math.min(1,x));return x*x*(3-2*x);};
const norm=([x,y])=>[x/W,y/H];
const rot=(p,pivot,a,shift=[0,0])=>{const c=Math.cos(a),s=Math.sin(a),x=p[0]-pivot[0],y=p[1]-pivot[1];return[pivot[0]+c*x-s*y+shift[0],pivot[1]+s*x+c*y+shift[1]];};
const mesh={source:[[0,0],[1,0],[0,1],[1,1]],indices:[0,2,1,1,2,3]};
const rigid=fn=>({rasterMesh:mesh,deformedUV:mesh.source.map(([u,v])=>norm(fn([u*W,v*H])))});
function grid(){const source=[],indices=[],cols=29,rows=29;for(let y=0;y<rows;y++)for(let x=0;x<cols;x++)source.push(norm([190+x*520/(cols-1),y*560/(rows-1)]));for(let y=0;y<rows-1;y++)for(let x=0;x<cols-1;x++){const a=y*cols+x;indices.push(a,a+cols,a+1,a+1,a+cols,a+cols+1);}return{source,indices,root:norm(root)};}
const bodyMesh=grid(),L1=Math.hypot(elbow0[0]-root[0],elbow0[1]-root[1]),L2=Math.hypot(wrist0[0]-elbow0[0],wrist0[1]-elbow0[1]);
const keys=[[0,396,393,-.4],[.12,390,403,-1.2],[.65,396,323,0],[.86,430,267,.9],[1,426,273,.6]];
function motion(p){let i=1;while(i<keys.length-1&&p>keys[i][0])i++;const a=keys[i-1],b=keys[i],s=smooth((p-a[0])/(b[0]-a[0]));return a.slice(1).map((v,k)=>v+(b[k+1]-v)*s);}
function pose(progress){const[x,y,lean]=motion(progress),wrist=[x,y],dx=wrist[0]-root[0],dy=wrist[1]-root[1],d=Math.hypot(dx,dy),theta=Math.atan2(dy,dx)+Math.acos(Math.max(-1,Math.min(1,(L1*L1+d*d-L2*L2)/(2*L1*d)))),elbow=[root[0]+L1*Math.cos(theta),root[1]+L1*Math.sin(theta)],upper=theta-Math.atan2(elbow0[1]-root[1],elbow0[0]-root[0]),fore=Math.atan2(wrist[1]-elbow[1],wrist[0]-elbow[0])-Math.atan2(wrist0[1]-elbow0[1],wrist0[0]-elbow0[0]),shift=[elbow[0]-elbow0[0],elbow[1]-elbow0[1]],arm=p=>rot(p,elbow0,fore,shift);return{elbow,wrist,upper,fore,arm,lean:lean*Math.PI/180};}
export function sample(progress,assets){
 if(!Number.isFinite(progress)||progress<0||progress>1)throw RangeError('Finite scene03 progress0..1 required');
 const p=pose(progress),torso=q=>rot(q,[420,535],p.lean),body=bodyMesh.source.map(([u,v])=>{const q=[u*W,v*H],turned=rot(q,root,p.upper),weight=smooth((350-q[0])/100)*smooth((430-q[1])/90);return norm(torso([q[0]+(turned[0]-q[0])*weight,q[1]+(turned[1]-q[1])*weight]));}),grip=torso(p.arm(grip0)),base=torso(p.arm(base0));
 const layers=[{id:'joint-underlap',image:assets['joint-underlap'],role:'actor',order:0,...rigid(q=>torso(rot(q,root,p.upper)))},{id:'actor-core',image:assets.core,role:'actor',order:1,rasterMesh:bodyMesh,deformedUV:body},{id:'upper-arm',image:assets['upper-arm'],role:'actor',order:2,...rigid(q=>torso(rot(q,root,p.upper)))},{id:'leaf',image:assets.leaf,role:'prop',order:3,...rigid(q=>torso(p.arm(q)))},{id:'forearm-hand',image:assets['forearm-hand'],role:'actor',order:4,...rigid(q=>torso(p.arm(q)))},{id:'support-arm',image:assets['support-arm'],role:'actor',order:5,rasterMesh:bodyMesh,deformedUV:bodyMesh.source.map(([u,v])=>{const q=[u*W,v*H],m=torso(q),w=1-smooth((q[1]-320)/110);return norm([q[0]+(m[0]-q[0])*w,q[1]+(m[1]-q[1])*w]);})},{id:'bag-contents',image:assets['bag-contents'],role:'foreground',order:6},{id:'bag-front',image:assets.bag,role:'foreground',order:7},{id:'bag-right',image:assets.bagRight,role:'foreground',order:8},{id:'foreground-produce',image:assets.foreground,role:'foreground',order:9}];
 return{layers,contacts:[{id:'leaf-grip',kind:'grip',point:grip,target:'prop:leaf',layerId:'forearm-hand',active:true,targetPoint:grip,gapNative:0},{id:'leaf-setdown',kind:'release',point:base,target:'worktop',active:false,reason:'No admitted clear worktop support; source action ends with leaf supported in hand.'}],screen:null,phase:progress===1?'settled':progress<.65?'action':'contact',diagnostics:{elbowNative:torso(p.elbow),wristNative:torso(p.wrist),gripNative:grip,leafBaseNative:base,upperLengthNative:Math.hypot(p.elbow[0]-root[0],p.elbow[1]-root[1]),forearmLengthNative:Math.hypot(p.wrist[0]-p.elbow[0],p.wrist[1]-p.elbow[1]),sourceGuideRootNative:torso(root),torsoLeanRadians:p.lean,motionStage:progress<.12?"anticipation":progress<.86?"lift":"settle",gripGapNative:0,release:'Inactive: no invented support or opacity handoff.',bodyMaterial:'Source-guided concealed cloth candidate; remaining contour/cloth repair needs integrated visual review.'}};
}
