// Source-local two-hand retrieval. Shared master exclusively owns time/world/camera.
export const id=4;
export const durationMs=4200;
export const reference={width:1041,height:633,source:{path:'/home/user/src/offmenu-data/runtime/layout-migration/worker05/native-browser-kitchen-15-20261026/v4-keyframe-world/targets/target-04.png',sha256:'17e2316dc39ad8b129d415a58c173e4d6c7dee4e11773a620027af63aed0404a'},anchors:{neck:[625,197],shoulder:null,elbow:null,wrist:[859,196],index:[935,165],grip:[914,186],lowerWrist:[866,328],lowerGrip:[927,306],upperCuff:[727,271],lowerCuff:[690,382],propGrip:[914,186],propBase:[950,314],propContact:[927,306],support:null,tabletGlass:null},anchorQualification:{neck:'Visible neck/cloth boundary, manually traced source pixels ±5px.',shoulder:'Anatomical joint hidden under cloth; null, not a rotation hinge.',elbow:'No anatomical pivot inferred; weighted source skin only.',wrist:'Visible upper wrist contour approximate ±5px.',index:'Visible curled fingertip approximate ±5px; no tap.',grip:'Visible upper hand/lid boundary approximate ±5px; lowerGrip visible hand/base boundary.',support:'Jar is held throughout. No surveyed shelf support or setdown.',tabletGlass:'Tablet present but approved decoded screen asset not supplied to helper; master retains screen. No invented quadrilateral or UI.'}};
const names=['core','upper-arm-hand','lower-arm-hand','jar','foreground'];
export async function load({loadImage,resolveAsset}){return Object.fromEntries(await Promise.all(names.map(async n=>[n,await loadImage(resolveAsset('./assets/scene-04/'+n+'.png'))])));}
const W=1041,H=633,clamp=x=>Math.max(0,Math.min(1,x)),smooth=x=>{x=clamp(x);return x*x*(3-2*x);};
// Cuffs remain fixed; distal source skin translates with the held jar.
function grid(root,tip){const source=[],indices=[],weights=[];for(let j=0;j<=16;j++)for(let i=0;i<=32;i++){let u=i/32,v=j/16;source.push([u,v]);weights.push(smooth((u*W-root)/(tip-root)));}for(let j=0;j<16;j++)for(let i=0;i<32;i++){let a=j*33+i;indices.push(a,a+1,a+33,a+1,a+34,a+33);}return {source,indices,weights};}
const upper=grid(745,895),lower=grid(730,900),rigid=grid(0,1);
function deform(g,delta,all=false){return {rasterMesh:{source:g.source,indices:g.indices},deformedUV:g.source.map(([u,v],i)=>[u+delta[0]*(all?1:g.weights[i])/W,v+delta[1]*(all?1:g.weights[i])/H])};}
export function sample(progress,assets){if(!Number.isFinite(progress)||progress<0||progress>1)throw RangeError('Finite scene04 progress 0..1 required');let t,delta;if(progress<=.65){t=1-smooth(progress/.65);delta=[18*t,-8*t];}else{t=smooth((progress-.65)/.35);delta=[-76*t,42*t];}const held=p=>[p[0]+delta[0],p[1]+delta[1]];
 const layers=[{id:'actor-core',image:assets.core,role:'actor',order:0},{id:'jar',image:assets.jar,role:'prop',order:1,...deform(rigid,delta,true)},{id:'upper-arm-hand',image:assets['upper-arm-hand'],role:'actor',order:2,...deform(upper,delta)},{id:'lower-arm-hand',image:assets['lower-arm-hand'],role:'actor',order:3,...deform(lower,delta)},{id:'foreground',image:assets.foreground,role:'foreground',order:4}];
 const contacts=[['upper-jar-grip',[914,186]],['lower-jar-grip',[927,306]]].map(([id,p])=>({id,kind:'grip',point:held(p),target:'prop:jar',targetPoint:held(p),active:true,gapNative:0}));contacts.push({id:'jar-release',kind:'release',point:held([950,314]),target:'prop:jar',active:false,reason:'Both hands retain the jar; no invented support or setdown.'});
 return {layers,contacts,screen:null,phase:progress===1?'settled':progress===.65?'contact':'action',diagnostics:{jarTranslationNative:delta,upperCuffNative:[727,271],lowerCuffNative:[690,382],upperCuffGapNative:0,lowerCuffGapNative:0,supportGapNative:null,releaseGapNative:null,sourcePose:progress===.65,qualification:'Source-local candidate; source material concerns and shared-world contact remain unaccepted.'}};
}
