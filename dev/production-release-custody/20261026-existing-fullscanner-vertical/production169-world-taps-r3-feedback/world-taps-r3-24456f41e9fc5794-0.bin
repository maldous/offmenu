import {V} from '../../landing-first-pair-v12-integration/scene-camera.mjs';
import {fixedGlassWorld,planeInverseDepth,bindTabletFrame} from '../world-contact-bindings.mjs';
import {sampleModule} from '../scene-module-runtime-r4.mjs';
export function createWorld06Binding(loaded,shared,camera){
 const glass=fixedGlassWorld(shared),center=[0,1,2].map(i=>glass.reduce((sum,p)=>sum+p[i],0)/4),forward=V.sub(camera.lookAt,camera.position),normal=V.unit([forward[0],forward[1],0]),actorPlaneABC=planeInverseDepth(camera,normal,V.sub(center,V.scale(normal,.35))),platePlane=planeInverseDepth(camera,[0,0,1],[0,0,.601]);
 const gap=Math.max(...[0,1].flatMap(p=>sampleModule(loaded.module,loaded.assets,p).contacts.map(c=>Math.hypot(c.point[0]-c.targetPoint[0],c.point[1]-c.targetPoint[1]))));
 return frame=>{
  const bound=bindTabletFrame(loaded,frame,{shared,camera,actorPlaneABC,endpointGapNative:gap});
  // The plate source is bottom-cropped. Sample only its measured alpha bbox, so an invisible full-image quad cannot cross the worktop horizon.
  const rect=[799/1047,527/633,248/1047,106/633];bound.frame.layers=bound.frame.layers.map(layer=>layer.id==='nutrition-meal-plate'?{...layer,rect,sample:rect}:layer);
  return {frame:bound.frame,registration:{camera,referenceCamera:camera,placements:{actor:{planeDepthABC:actorPlaneABC},foreground:{planeDepthABC:actorPlaneABC},'nutrition-meal-plate':{planeDepthABC:platePlane},...bound.placements}},qualification:'JOINT_WINDOW_TABLET_CAMERA_CANDIDATE_ACTUAL_ROOM_BODY_AND_PROP_VISUAL_REVIEW_PENDING'};
 };
}
