import {SceneRenderer,loadImage} from '../../next03-04/scene-renderer.mjs';
import {loadSceneModule,createModuleChapter,drawWorldFrame} from '../scene-module-runtime-r4.mjs';
import {createWorld06Binding} from '../scene06-joint-calibration-r3/world-binding.mjs';
import {createTabletSceneBinding} from './tablet-scene-binding.mjs';
import {scenes} from './registration.mjs';
const abort=()=>new DOMException('Landing action superseded','AbortError');
export async function mountWorldAction({id,canvas,signal,assetBase=new URL('/landing-motion-v12/',location.href),onError=()=>{}}){
 if(signal?.aborted)throw abort();const selected=scenes[id];if(!selected)throw Error('World scene unavailable: '+id);
 const json=async url=>{const r=await fetch(url,{signal});if(!r.ok)throw Error('Missing world asset: '+url);return r.json();},file=path=>new URL(path,assetBase).href;
 const [spec,layers,loaded]=await Promise.all([json(file('assets/room-surfaces.json')),json(file('assets/layers.json')),loadSceneModule(new URL(selected.moduleURL,import.meta.url).href,{loadImage,readJSON:json})]);
 const shared={room:{spec,atlas:await loadImage(file(spec.atlas.url))},glass:layers.glass,bezel:await loadImage(file(layers.layers.bezel.url))};if(signal?.aborted)throw abort();const renderer=new SceneRenderer(canvas),bind=id===6?createWorld06Binding(loaded,shared,selected.camera):createTabletSceneBinding(loaded,shared,selected.camera);
 const state={id,qualification:'MULTI_SCENE_VERTICAL_LANDING_SHARED_WORLD_CANDIDATE_NOT_ACCEPTED',frames:0,progress:0,paused:true,finished:false,error:null,contacts:[],bodyPlaneQualification:'DEVELOPMENT_PLANE_NOT_MEASURED_BODY_REGISTRATION'};
 const chapter=createModuleChapter(loaded,{draw(progress,frame){const bound=bind(frame);drawWorldFrame(renderer,shared,loaded,bound.frame,bound.registration);state.frames++;state.progress=progress;state.contacts=bound.frame.contacts;state.supports=bound.supports||[];canvas.dataset.chapter=String(id);canvas.dataset.phase=bound.frame.phase;}});
 let controller=null,disposed=false,running=null;function stop(){const old=controller;controller=null;old?.abort();}chapter.mount(canvas.parentNode);
 return {async play(){if(disposed)throw abort();if(running)return running;state.paused=false;const own=controller=new AbortController();running=chapter.play({signal:own.signal,rate:1}).then(()=>{if(controller===own&&!disposed)state.finished=true;}).catch(error=>{if(error.name!=='AbortError'){state.error=error.message;onError(error);}throw error;}).finally(()=>{if(controller===own)controller=null;running=null;});return running;},setPaused(value){state.paused=Boolean(value);if(value)stop();},getState:()=>structuredClone({...state,chapter:chapter.getState()}),dispose(){if(disposed)return;disposed=true;stop();chapter.dispose();renderer.dispose();}};
}
