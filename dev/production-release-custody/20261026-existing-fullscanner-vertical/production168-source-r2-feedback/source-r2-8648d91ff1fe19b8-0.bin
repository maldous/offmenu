import * as base from '../scene-11.mjs';
import {grid} from '../action-math.mjs';
import {sourceSkin,poseFor,bodyLayer} from './actor-motion.mjs';
export const id=11;export const durationMs=3500;export const reference={...base.reference,actionRevision:'R4 head/torso-led history indication with complete source-registered forearm underlap',anchors:{...base.reference.anchors,armCropRoot:[880,730]},newMaterial:'Same authored14 character hand/forearm material source-registered to11index/root; original shirt/head/UI preserved; not original11extraction'};
const width=reference.width,height=reference.height,root=reference.anchors.armCropRoot,index=reference.anchors.index,mesh=grid(width,height,{root,index,extra:[]});
export async function load(ctx){const get=p=>ctx.loadImage(ctx.resolveAsset(p));return {actorCore:await get('./scene-11-core-fringe-r1.png'),pointArm:await get('./scene-11-interaction-arm.png'),notebook:await get('../assets/scene-11/notebook.png'),cup:await get('../assets/scene-11/cup.png'),screen:await get('../assets/scene-11/approved-screen.png')};}
export function sample(p,assets){const f=base.sample(.65,assets),pose=poseFor(id,p),arm=f.layers.find(l=>l.rasterMesh),uv=sourceSkin(mesh,{width,height,root,index},pose,{pinCrop:id===13});arm.rasterMesh=mesh;arm.deformedUV=uv;
 const contact=f.contacts[0];contact.point=[index[0]+pose.shift[0],index[1]+pose.shift[1]];contact.active=p>=.38&&p<=.66;contact.frontNormalSeparationInTabletWidths=contact.active?0:Math.hypot(...pose.shift)/500;
 const ci=f.layers.findIndex(l=>/actor-core/.test(l.id));f.layers[ci]=bodyLayer(f.layers[ci],id,p,reference);
 f.phase=p===1?'settled':contact.active?'contact':p>.66?'release':'action';f.motionStage=p<.18?'prepare-and-look':contact.active?'read-and-indicate':p>.66?'release-and-recover':'reach';return f;}
