import {drawTexturedMesh,disposeTexturedMesh} from './seamless-layer-raster-r1.mjs';
// Finite diagnostic consumer of the SAME authored module API; never a final room render.
import {loadSceneModule,createModuleChapter,fitSourceViewport} from './scene-module-runtime-r3.mjs';
import {createChapterMaster} from '../landing-first-pair-v12-integration/controller/chapter-master.mjs';
function image(url){return new Promise((resolve,reject)=>{const i=new Image();i.onload=()=>resolve(i);i.onerror=()=>reject(Error('Missing source image: '+url));i.src=url;});}
function sourceScreen(ctx,image,quad,reference,viewport){
 if(!image)return;if(!Array.isArray(quad)||quad.length!==4)throw Error('Approved screen requires measured native glass quad');
 const p=quad.map(([x,y])=>[viewport.x+x/reference.width*viewport.width,viewport.y+y/reference.height*viewport.height]);
 const[a,b,c,d]=p,dx1=b[0]-c[0],dx2=d[0]-c[0],dx3=a[0]-b[0]+c[0]-d[0],dy1=b[1]-c[1],dy2=d[1]-c[1],dy3=a[1]-b[1]+c[1]-d[1],den=dx1*dy2-dx2*dy1;
 const g=(dx3*dy2-dx2*dy3)/den,h=(dx1*dy3-dx3*dy1)/den,H=[b[0]-a[0]+g*b[0],d[0]-a[0]+h*d[0],a[0],b[1]-a[1]+g*b[1],d[1]-a[1]+h*d[1],a[1],g,h,1];
 const map=([u,v])=>{const q=H[6]*u+H[7]*v+1;return[(H[0]*u+H[1]*v+H[2])/q,(H[3]*u+H[4]*v+H[5])/q];};
 const source=[],dest=[],indices=[];for(let y=0;y<12;y++)for(let x=0;x<16;x++){const uv=[[x/16,y/12],[(x+1)/16,y/12],[(x+1)/16,(y+1)/12],[x/16,(y+1)/12]];const start=source.length;source.push(...uv.map(([u,v])=>[u*image.naturalWidth,v*image.naturalHeight]));dest.push(...uv.map(map));indices.push(start,start+1,start+2,start,start+2,start+3);}drawTexturedMesh(ctx,image,source,dest,indices);
}
function drawSource(canvas,loaded,frame){const ctx=canvas.getContext('2d'),viewport=fitSourceViewport(canvas.width,canvas.height,loaded.module.reference.width/loaded.module.reference.height);ctx.setTransform(1,0,0,1,0,0);ctx.fillStyle='#d9dde2';ctx.fillRect(0,0,canvas.width,canvas.height);sourceScreen(ctx,frame.screen,loaded.module.reference.anchors?.tabletGlass,loaded.module.reference,viewport);for(const layer of [...frame.layers].sort((a,b)=>a.order-b.order)){const img=layer.image,rect=layer.rect||[0,0,1,1],sample=layer.sample||[0,0,1,1],mesh=layer.rasterMesh,uv=mesh?.source||[[rect[0],rect[1]],[rect[0]+rect[2],rect[1]],[rect[0],rect[1]+rect[3]],[rect[0]+rect[2],rect[1]+rect[3]]],target=layer.deformedUV||uv;const transform=layer.transform||{},pivot=transform.pivot||[.5,.5],shift=transform.shift||[0,0],a=transform.angle||0,c=Math.cos(a),s=Math.sin(a);const source=uv.map(([u,v])=>[(sample[0]+(u-rect[0])/rect[2]*sample[2])*img.naturalWidth,(sample[1]+(v-rect[1])/rect[3]*sample[3])*img.naturalHeight]);const dest=target.map(([u,v])=>{const x=u-pivot[0],y=v-pivot[1];return[viewport.x+(pivot[0]+x*c-y*s+shift[0])*viewport.width,viewport.y+(pivot[1]+x*s+y*c+shift[1])*viewport.height];});const indices=mesh?.indices||[0,2,1,1,2,3];drawTexturedMesh(ctx,img,source,dest,indices);}}
export async function mountSourceActionPreview(canvas,moduleURL){const loaded=await loadSceneModule(moduleURL,{loadImage:image});const state={qualification:'SOURCE_PART_ACTION_ONLY_NOT_WORLD_ACCEPTANCE',id:loaded.module.id,frames:0,progress:0,contacts:[],finished:false,error:null};const chapter=createModuleChapter(loaded,{draw(progress,frame){state.progress=progress;state.contacts=frame.contacts;state.frames++;drawSource(canvas,loaded,frame);}});const master=createChapterMaster({chapters:[chapter],host:canvas.parentNode,onError(error){state.error=error.message;}});const visibility=()=>master.setPaused(document.hidden);document.addEventListener('visibilitychange',visibility);visibility();master.start();master.completion.then(result=>{state.finished=true;state.result=result.status;master.dispose();chapter.dispose();disposeTexturedMesh(canvas.getContext('2d'));document.removeEventListener('visibilitychange',visibility);});const dispose=()=>{master.dispose();chapter.dispose();disposeTexturedMesh(canvas.getContext('2d'));document.removeEventListener('visibilitychange',visibility);};addEventListener('pagehide',dispose,{once:true});return{getState:()=>structuredClone(state),dispose};}
