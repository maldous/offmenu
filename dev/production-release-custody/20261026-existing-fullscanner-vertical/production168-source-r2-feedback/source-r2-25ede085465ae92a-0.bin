// Serving: pan stability, loaded spoon travel, persistent food transfer, retract.
export const id=8;
export const durationMs=3200;
const W=1014,H=624,panGrip=[278,212],spoonGrip=[187,360],foodBase=[524,453],plateSupport=[604,490];
export const reference={width:W,height:H,
 source:{path:'/home/user/src/offmenu-data/runtime/layout-migration/worker05/native-browser-kitchen-15-20261026/v4-keyframe-world/targets/target-08.png',sha256:'55dcda8c90df1d8f68c1546c7627dd6dcb9c00ed7d9d7ffdbcb471cc804a5ca2'},
 anchors:{neck:null,shoulder:null,elbow:null,wrist:null,index:null,grip:spoonGrip,panGrip,propBase:foodBase,support:plateSupport,
  panArmEntry:[0,75],spoonArmEntry:[0,298],tabletGlass:[[726,78],[948,108],[915,279],[678,240]]},
 anchorReasons:{neck:'Actor torso/head are outside this approved serving view.',shoulder:'Both arms enter left crop.',elbow:'Outside crop; no invented anatomical joint.',wrist:'Hands partly obscure handle; exact wrist centre unavailable.',index:'Grip action, not index tap.',grip:'Observed spoon handle grip±5pixels; pan grip±5.',propBase:'Observed source spoonful bottom approx524453±6.',support:'Authored food-placement point inside visible right plate; fixed-world plate/contact surface requires master binding.'},
 action:'Lift a loaded spoon while the other hand steadies the pan, carry over right plate, tip, let the same portion settle, then lift/retract empty spoon. No food disappearance or UI/data mutation.'};
const clamp=x=>Math.max(0,Math.min(1,x));
// Hermite trajectory with continuous internal velocities; explicit stop at support.
function curve(p,keys){
 if(p<=keys[0][0])return keys[0][1];if(p>=keys.at(-1)[0])return keys.at(-1)[1];
 const slope=i=>keys[i][2]??(i===0||i===keys.length-1?0:(keys[i+1][1]-keys[i-1][1])/(keys[i+1][0]-keys[i-1][0]));
 for(let i=1;i<keys.length;i++)if(p<=keys[i][0]){const a=keys[i-1],b=keys[i],dt=b[0]-a[0],t=(p-a[0])/dt,t2=t*t,t3=t2*t;return(2*t3-3*t2+1)*a[1]+(t3-2*t2+t)*dt*slope(i-1)+(-2*t3+3*t2)*b[1]+(t3-t2)*dt*slope(i);}
}
function spoonPose(p){return{rigidX:103,pivot:spoonGrip,shift:[curve(p,[[0,-45],[.18,-25],[.38,-25],[.65,0],[.78,70],[.88,72],[1,0]]),curve(p,[[0,-100],[.18,-95],[.38,-50],[.65,0],[.78,25],[.88,25],[1,-55]])],angle:curve(p,[[0,-.08],[.3,-.04],[.65,0],[.78,0],[.86,.12],[.95,.04],[1,0]])};}
function panPose(p){return{rigidX:150,pivot:panGrip,shift:[0,0],angle:curve(p,[[0,.012],[.25,-.008],[.65,0],[.85,.015],[1,0]])};}
function portionPose(p,spoon){if(p<=.78)return spoon;return{pivot:foodBase,shift:[curve(p,[[.78,70],[.86,80,0],[1,80,0]]),curve(p,[[.78,25],[.86,37,0],[1,37,0]])],angle:curve(p,[[.78,0],[.82,.04],[.86,0,0],[1,0,0]])};}
function rigid(point,pose){const [x,y]=point,[px,py]=pose.pivot,dx=(x-px)/W,dy=(y-py)/H,c=Math.cos(pose.angle),s=Math.sin(pose.angle);return[(px/W+dx*c-dy*s)*W+pose.shift[0],(py/H+dx*s+dy*c)*H+pose.shift[1]];}
const transform=p=>({pivot:[p.pivot[0]/W,p.pivot[1]/H],angle:p.angle,shift:[p.shift[0]/W,p.shift[1]/H]});
function makeMesh(bounds,root,grip){
 const [x0,y0,x1,y1]=bounds;
 const xs=[...new Set([...Array.from({length:42},(_,i)=>(x0+(x1-x0)*i/41)/W),grip[0]/W])].sort((a,b)=>a-b);
 const ys=[...new Set([...Array.from({length:29},(_,i)=>(y0+(y1-y0)*i/28)/H),root[1]/H,grip[1]/H])].sort((a,b)=>a-b);
 const source=ys.flatMap(v=>xs.map(u=>[u,v])),indices=[];
 for(let y=0;y<ys.length-1;y++)for(let x=0;x<xs.length-1;x++){const k=y*xs.length+x;indices.push(k,k+xs.length,k+1,k+1,k+xs.length,k+xs.length+1);}
 return{source,indices,root:[root[0]/W,root[1]/H],gripContact:[grip[0]/W,grip[1]/H]};
}
const panMesh=makeMesh([0,8,318,270],[0,75],panGrip),spoonMesh=makeMesh([0,228,255,424],[0,298],spoonGrip);
function armUV(point,pose){const[u,v]=point,x=u*W,y=v*H,t=clamp(x/pose.rigidX),weight=t*t*(3-2*t),moved=rigid([x,y],pose);return[(x+(moved[0]-x)*weight)/W,(y+(moved[1]-y)*weight)/H];}
export async function load({loadImage,resolveAsset}){const names={panArm:'panGripArm',spoonArm:'spoonGripArm',pan:'pan-clean-r2',spoon:'emptySpoon',portion:'portion',leftPlate:'leftPlate-clean-r3',rightPlate:'rightPlate-clean',screen:'approved-screen'};return Object.fromEntries(await Promise.all(Object.entries(names).map(async([key,file])=>[key,await loadImage(resolveAsset(`./assets/${file}.png`))])));}
export function sample(progress,assets){const p=clamp(progress),spoon=spoonPose(p),pan=panPose(p),food=portionPose(p,spoon),foodPoint=rigid(foodBase,food);return{
 layers:[
  {id:'serving-left-plate',image:assets.leftPlate,role:'prop',order:0},
  {id:'serving-right-plate',image:assets.rightPlate,role:'prop',order:1},
  {id:'serving-pan',image:assets.pan,role:'prop',order:10,transform:transform(pan)},
  {id:'serving-pan-hand',image:assets.panArm,role:'actor',order:15,rasterMesh:panMesh,deformedUV:panMesh.source.map(uv=>armUV(uv,pan))},
  {id:'serving-spoon',image:assets.spoon,role:'prop',order:20,transform:transform(spoon)},
  {id:'serving-portion',image:assets.portion,role:'prop',order:p<.84?25:18,transform:transform(food)},
  {id:'serving-spoon-hand',image:assets.spoonArm,role:'actor',order:30,rasterMesh:spoonMesh,deformedUV:spoonMesh.source.map(uv=>armUV(uv,spoon))}
 ],contacts:[
  {id:'serving-pan-grip',layerId:'serving-pan-hand',kind:'grip',point:rigid(panGrip,pan),target:'prop:serving-pan',active:true,targetPoint:rigid(panGrip,pan)},
  {id:'serving-spoon-grip',layerId:'serving-spoon-hand',kind:'grip',point:rigid(spoonGrip,spoon),target:'prop:serving-spoon',active:true,targetPoint:rigid(spoonGrip,spoon)},
  {id:'serving-portion-carry',layerId:'serving-portion',kind:'grip',point:foodPoint,target:'prop:serving-spoon',active:p<=.78,targetPoint:rigid(foodBase,spoon)},
  {id:'serving-portion-transfer',layerId:'serving-portion',kind:'release',point:foodPoint,target:'prop:serving-right-plate',active:p>.78&&p<.86},
  {id:'serving-portion-support',layerId:'serving-portion',kind:'support',point:foodPoint,target:'prop:serving-right-plate',active:p>=.86,targetPoint:plateSupport}
 ],screen:assets.screen,phase:p<=.78?'action':p<.86?'release':p<.98?'contact':'settled',worldSupportQualified:false};}
export function dispose(){}
