// Finite diagnostic consumer of the SAME authored module API; never a final room render.
import {loadSceneModule,createModuleChapter,fitSourceViewport} from './scene-module-runtime-r3.mjs';
import {createChapterMaster} from '../landing-first-pair-v12-integration/controller/chapter-master.mjs';
function image(url){return new Promise((resolve,reject)=>{const i=new Image();i.onload=()=>resolve(i);i.onerror=()=>reject(Error('Missing source image: '+url));i.src=url;});}
function triangle(ctx,img,source,dest){const [a,b,c]=source,[A,B,C]=dest,den=a[0]*(b[1]-c[1])+b[0]*(c[1]-a[1])+c[0]*(a[1]-b[1]);if(Math.abs(den)<1e-8)return;const coefficients=values=>[(values[0]*(b[1]-c[1])+values[1]*(c[1]-a[1])+values[2]*(a[1]-b[1]))/den,(values[0]*(c[0]-b[0])+values[1]*(a[0]-c[0])+values[2]*(b[0]-a[0]))/den,(values[0]*(b[0]*c[1]-c[0]*b[1])+values[1]*(c[0]*a[1]-a[0]*c[1])+values[2]*(a[0]*b[1]-b[0]*a[1]))/den];const x=coefficients([A[0],B[0],C[0]]),y=coefficients([A[1],B[1],C[1]]);ctx.save();ctx.beginPath();ctx.moveTo(...A);ctx.lineTo(...B);ctx.lineTo(...C);ctx.closePath();ctx.clip();ctx.transform(x[0],y[0],x[1],y[1],x[2],y[2]);ctx.drawImage(img,0,0);ctx.restore();}
function sourceScreen(ctx,image,quad,reference,viewport){
 if(!image)return;if(!Array.isArray(quad)||quad.length!==4)throw Error('Approved screen requires measured native glass quad');
 const p=quad.map(([x,y])=>[viewport.x+x/reference.width*viewport.width,viewport.y+y/reference.height*viewport.height]);
 const[a,b,c,d]=p,dx1=b[0]-c[0],dx2=d[0]-c[0],dx3=a[0]-b[0]+c[0]-d[0],dy1=b[1]-c[1],dy2=d[1]-c[1],dy3=a[1]-b[1]+c[1]-d[1],den=dx1*dy2-dx2*dy1;
 const g=(dx3*dy2-dx2*dy3)/den,h=(dx1*dy3-dx3*dy1)/den,H=[b[0]-a[0]+g*b[0],d[0]-a[0]+h*d[0],a[0],b[1]-a[1]+g*b[1],d[1]-a[1]+h*d[1],a[1],g,h,1];
 const map=([u,v])=>{const q=H[6]*u+H[7]*v+1;return[(H[0]*u+H[1]*v+H[2])/q,(H[3]*u+H[4]*v+H[5])/q];};
 for(let y=0;y<12;y++)for(let x=0;x<16;x++){const uv=[[x/16,y/12],[(x+1)/16,y/12],[(x+1)/16,(y+1)/12],[x/16,(y+1)/12]];for(const ids of [[0,1,2],[0,2,3]])triangle(ctx,image,ids.map(i=>[uv[i][0]*image.naturalWidth,uv[i][1]*image.naturalHeight]),ids.map(i=>map(uv[i])));}
}
function drawSource(canvas,loaded,frame){const ctx=canvas.getContext('2d'),viewport=fitSourceViewport(canvas.width,canvas.height,loaded.module.reference.width/loaded.module.reference.height);ctx.setTransform(1,0,0,1,0,0);ctx.fillStyle='#d9dde2';ctx.fillRect(0,0,canvas.width,canvas.height);sourceScreen(ctx,frame.screen,loaded.module.reference.anchors?.tabletGlass,loaded.module.reference,viewport);for(const layer of [...frame.layers].sort((a,b)=>a.order-b.order)){const img=layer.image,rect=layer.rect||[0,0,1,1],sample=layer.sample||[0,0,1,1],mesh=layer.rasterMesh,uv=mesh?.source||[[rect[0],rect[1]],[rect[0]+rect[2],rect[1]],[rect[0],rect[1]+rect[3]],[rect[0]+rect[2],rect[1]+rect[3]]],target=layer.deformedUV||uv;const transform=layer.transform||{},pivot=transform.pivot||[.5,.5],shift=transform.shift||[0,0],a=transform.angle||0,c=Math.cos(a),s=Math.sin(a);const source=uv.map(([u,v])=>[(sample[0]+(u-rect[0])/rect[2]*sample[2])*img.naturalWidth,(sample[1]+(v-rect[1])/rect[3]*sample[3])*img.naturalHeight]);const dest=target.map(([u,v])=>{const x=u-pivot[0],y=v-pivot[1];return[viewport.x+(pivot[0]+x*c-y*s+shift[0])*viewport.width,viewport.y+(pivot[1]+x*s+y*c+shift[1])*viewport.height];});const indices=mesh?.indices||[0,2,1,1,2,3];for(let i=0;i<indices.length;i+=3){const ids=indices.slice(i,i+3);triangle(ctx,img,ids.map(x=>source[x]),ids.map(x=>dest[x]));}}}
export async function mountSourceActionPreview(canvas,moduleURL){const loaded=await loadSceneModule(moduleURL,{loadImage:image});const state={qualification:'SOURCE_PART_ACTION_ONLY_NOT_WORLD_ACCEPTANCE',id:loaded.module.id,frames:0,progress:0,contacts:[],finished:false,error:null};const chapter=createModuleChapter(loaded,{draw(progress,frame){state.progress=progress;state.contacts=frame.contacts;state.frames++;drawSource(canvas,loaded,frame);}});const master=createChapterMaster({chapters:[chapter],host:canvas.parentNode,onError(error){state.error=error.message;}});const visibility=()=>master.setPaused(document.hidden);document.addEventListener('visibilitychange',visibility);visibility();master.start();master.completion.then(result=>{state.finished=true;state.result=result.status;master.dispose();chapter.dispose();document.removeEventListener('visibilitychange',visibility);});const dispose=()=>{master.dispose();chapter.dispose();document.removeEventListener('visibilitychange',visibility);};addEventListener('pagehide',dispose,{once:true});return{getState:()=>structuredClone(state),dispose};}
