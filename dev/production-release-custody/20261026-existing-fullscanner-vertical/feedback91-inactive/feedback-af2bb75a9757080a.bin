import {progress,contactWeight,phase,grid,deform,posedPoint} from './action-math.mjs';
export const id=11;
export const durationMs=4200;
export const reference={width:1014,height:645,source:{path:'/home/user/src/offmenu-data/runtime/layout-migration/worker05/native-browser-kitchen-15-20261026/v4-keyframe-world/targets/target-11.png',sha256:'ec18a708be1ad6db651c3dbf276d595fbdc3bb93bc265e3706181e2fbf6f8165'},anchors:{neck:null,shoulder:null,elbow:null,wrist:null,index:[487,307],grip:null,support:null,armCropRoot:[785,470],tabletGlass:[[168,138],[579,84],[648,462],[228,519]],propBase:null},anchorReasons:{neck:'Unverified/partly cropped R4 view',shoulder:'Occluded; supplied crop root is not anatomy',elbow:'Not visible, never inferred from bbox',wrist:'No verified anatomical joint; bend is a source-space control only',grip:'No held prop',support:'No setdown in pointing action',propBase:'Fixed source notebook/cup, master support registration pending'}};
const guides={root:[785,470],bend:[710,487],index:[487,307]};
const mesh=grid(reference.width,reference.height,{root:guides.root,index:guides.index,extra:[guides.bend]});
export async function load({loadImage,resolveAsset}){
 const out={};for(const name of ['actorCore','pointArm','notebook','cup'])out[name]=await loadImage(resolveAsset('./assets/scene-11/'+name+'.png'));
 out.screen=await loadImage(resolveAsset('./assets/scene-11/approved-screen.png'));return out;
}
export function sample(value,assets){
 const p=progress(value),weight=contactWeight(p),posed=deform(mesh,guides,weight,reference.width,reference.height);
 const tip=posedPoint(mesh.indexContact,guides,weight,reference.width,reference.height).map((v,i)=>v*(i?reference.height:reference.width));
 return {layers:[{id:'history-notebook',image:assets.notebook,role:'prop',order:10},{id:'history-cup',image:assets.cup,role:'prop',order:11},{id:'history-point-arm',image:assets.pointArm,role:'actor',order:30,rasterMesh:mesh,deformedUV:posed},{id:'history-actor-core',image:assets.actorCore,role:'foreground',order:40}],contacts:[{id:'history-index-glass',layerId:'history-point-arm',kind:'tap',point:tip,target:'tablet',active:p>=.6&&p<=.72,targetPoint:[487,307],glassUV:[.6875252830484102,.5496461446217158],frontNormalSeparationInTabletWidths:(1-weight)*.08}],screen:assets.screen,phase:phase(p)};
}
