export const reference={width:1041,height:663,source:{path:'/home/user/src/offmenu-data/runtime/layout-migration/worker05/native-browser-kitchen-15-20261026/v4-keyframe-world/targets/target-13.png',sha256:'b9e24d0b5da97f525a353a58e5e2e1639fe51d01dc991382b383fcd3ed4ec8e2'},anchors:{neck:null,shoulder:null,elbow:null,wrist:null,index:[631,388],grip:null,support:null,propGrip:null,propBase:null,propContact:null,armCropRoot:[1100,600],tabletGlass:[[147,120],[684,72],[786,522],[225,585]]},anchorReasons:{neck:'Outside crop; unverified',shoulder:'Outside crop; unverified',elbow:'Unverified; no bbox inference',wrist:'Unverified; no bbox inference',grip:'No grasp in approved pointing action',support:'No transfer or setdown in action',propGrip:'Cup is stationary, not grasped',propBase:'No verified cup support landmark supplied',propContact:'No moving prop contact; world support registration belongs master',armCropRoot:'Supplied off-canvas source control, not an anatomical joint'}};
const xs=[...new Set([...Array.from({length:27},(_,i)=>1041*i/26),631])].sort((a,b)=>a-b);
const ys=[...new Set([...Array.from({length:19},(_,i)=>663*i/18),388])].sort((a,b)=>a-b);
const source=ys.flatMap(y=>xs.map(x=>[x/1041,y/663])),indices=[];
for(let j=0;j<ys.length-1;j++)for(let i=0;i<xs.length-1;i++){const a=j*xs.length+i,b=a+1,c=a+xs.length,d=c+1;indices.push(a,b,c,b,d,c);}
const mesh={source,indices};
const smooth=t=>t*t*(3-2*t);
function separation(p){const knots=[[0,.08],[.4,.04],[.6,0],[.65,0],[.72,0],[.9,.06],[1,.08]];for(let i=1;i<knots.length;i++){const [b,y]=knots[i],[a,x]=knots[i-1];if(p<=b)return x+(y-x)*smooth((p-a)/(b-a));}return .08;}
const tabletWidth=Math.hypot(684-147,72-120),direction=[469/Math.hypot(469,212),212/Math.hypot(469,212)];
function posed(uv,gap){const x=uv[0]*1041,y=uv[1]*663;const weight=(1-smooth(Math.min(1,Math.max(0,(x-760)/(1041-760)))))*(1-smooth(Math.min(1,Math.max(0,(y-500)/(663-500)))));return [(x+direction[0]*gap*tabletWidth*weight)/1041,(y+direction[1]*gap*tabletWidth*weight)/663];}
export async function load({loadImage,readJSON,resolveAsset}){const assets={};for(const [key,name] of [['pointArm','pointArm'],['cup','cup'],['screen','approved-screen']])assets[key]=await loadImage(resolveAsset('./assets/'+name+'.png'));return assets;}
export function sample(progress,assets){if(!Number.isFinite(progress))throw new TypeError('Scene13 progress must be finite');const p=Math.max(0,Math.min(1,progress)),gap=separation(p),tip=posed([631/1041,388/663],gap).map((v,i)=>v*(i?663:1041));return {layers:[{id:'connection-cup',image:assets.cup,role:'prop',order:10},{id:'connection-point-arm',image:assets.pointArm,role:'actor',order:30,rasterMesh:mesh,deformedUV:source.map(uv=>posed(uv,gap))}],contacts:[{id:'connection-index-glass',layerId:'connection-point-arm',kind:'tap',point:tip,target:'tablet',targetPoint:[631,388],active:p>=.6&&p<=.72,glassUV:[.7752400043475608,.6842233861093796],frontNormalSeparationInTabletWidths:gap}],screen:assets.screen,phase:p>=1?'settled':p>.72?'release':p>=.6?'contact':'action'};}
