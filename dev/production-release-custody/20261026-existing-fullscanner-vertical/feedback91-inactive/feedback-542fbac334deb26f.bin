// Source-layered 2.5D scene. Every textured plane is projected through the authored camera.
export const mix=(a,b,t)=>a+(b-a)*t, smooth=t=>{t=Math.max(0,Math.min(1,t));return t*t*(3-2*t);};
export const V={add:(a,b)=>a.map((x,i)=>x+b[i]),sub:(a,b)=>a.map((x,i)=>x-b[i]),scale:(a,s)=>a.map(x=>x*s),dot:(a,b)=>a.reduce((s,x,i)=>s+x*b[i],0),cross:(a,b)=>[a[1]*b[2]-a[2]*b[1],a[2]*b[0]-a[0]*b[2],a[0]*b[1]-a[1]*b[0]],unit:a=>{const n=Math.hypot(...a);return a.map(x=>x/n);}};
export const CAMERA01={position:[.55,-1.1,1.65],lookAt:[.15,.8,1],focal:52};
export const CAMERA02={position:[.4,-.9,1.6],lookAt:[.15,.8,1],focal:58,offset:[-.12,.23]};
function basis(camera){const f=V.unit(V.sub(camera.lookAt,camera.position)),r=V.unit(V.cross(f,camera.up||[0,0,1])),u=V.cross(r,f);return{f,r,u};}
export function sourceWorld(x,y,depth,ref=CAMERA01){const b=basis(ref),sx=(x-.5-(ref.offset?.[0]||0)/2)*36/ref.focal,sy=(.5-y-(ref.offset?.[1]||0)/2)*36/(ref.focal*(ref.aspect||1040/628));return V.add(ref.position,V.scale(V.add(b.f,V.add(V.scale(b.r,sx),V.scale(b.u,sy))),depth));}
export function cameraAt(t,references={1:CAMERA01,2:CAMERA02}){t=smooth(t);const a=references[1],b=references[2];return{position:a.position.map((v,i)=>mix(v,b.position[i],t)),lookAt:a.lookAt.map((v,i)=>mix(v,b.lookAt[i],t)),focal:mix(a.focal,b.focal,t),offset:[0,1].map(i=>mix(a.offset?.[i]||0,b.offset?.[i]||0,t)),up:basis(a).u.map((v,i)=>mix(v,basis(b).u[i],t)),aspect:mix(a.aspect||1040/628,b.aspect||1040/628,t)};}
export function project(point,camera){const b=basis(camera),d=V.sub(point,camera.position),z=V.dot(d,b.f);return[(V.dot(d,b.r)*camera.focal/18)/z+(camera.offset?.[0]||0),(V.dot(d,b.u)*camera.focal*(camera.aspect||1040/628)/18)/z+(camera.offset?.[1]||0),z];}

