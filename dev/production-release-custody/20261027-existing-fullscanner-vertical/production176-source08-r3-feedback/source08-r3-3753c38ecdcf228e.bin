 const vs=compile(gl,gl.VERTEX_SHADER,'attribute vec2 position;attribute vec2 uv;varying vec2 sourceUV;void main(){sourceUV=uv;gl_Position=vec4(position,0.0,1.0);}'),fs=compile(gl,gl.FRAGMENT_SHADER,'precision highp float;varying vec2 sourceUV;uniform sampler2D image;void main(){gl_FragColor=texture2D(image,sourceUV);}');
 const program=gl.createProgram();gl.attachShader(program,vs);gl.attachShader(program,fs);gl.linkProgram(program);gl.deleteShader(vs);gl.deleteShader(fs);if(!gl.getProgramParameter(program,gl.LINK_STATUS))throw Error(gl.getProgramInfoLog(program));
 const state={canvas,gl,program,vertices:gl.createBuffer(),indices:gl.createBuffer(),textures:new WeakMap(),ownedTextures:new Set(),position:gl.getAttribLocation(program,'position'),uv:gl.getAttribLocation(program,'uv'),sampler:gl.getUniformLocation(program,'image')};surfaces.set(ctx,state);return state;
}
export function drawTexturedMesh(ctx,image,source,dest,indices){if(source.length!==dest.length||source.length>65535||indices.length%3)throw Error('Invalid bounded source mesh');const s=surfaces.get(ctx)||create(ctx),{gl,canvas}=s,width=ctx.canvas.width,height=ctx.canvas.height;if(canvas.width!==width||canvas.height!==height){canvas.width=width;canvas.height=height;}
 const iw=image.naturalWidth||image.width,ih=image.naturalHeight||image.height,data=new Float32Array(source.length*4);for(let i=0;i<source.length;i++){data[i*4]=dest[i][0]/width*2-1;data[i*4+1]=1-dest[i][1]/height*2;data[i*4+2]=source[i][0]/iw;data[i*4+3]=source[i][1]/ih;}
 let texture=s.textures.get(image);if(!texture){texture=gl.createTexture();gl.bindTexture(gl.TEXTURE_2D,texture);gl.pixelStorei(gl.UNPACK_PREMULTIPLY_ALPHA_WEBGL,true);gl.texParameteri(gl.TEXTURE_2D,gl.TEXTURE_MIN_FILTER,gl.LINEAR);gl.texParameteri(gl.TEXTURE_2D,gl.TEXTURE_MAG_FILTER,gl.LINEAR);gl.texParameteri(gl.TEXTURE_2D,gl.TEXTURE_WRAP_S,gl.CLAMP_TO_EDGE);gl.texParameteri(gl.TEXTURE_2D,gl.TEXTURE_WRAP_T,gl.CLAMP_TO_EDGE);gl.texImage2D(gl.TEXTURE_2D,0,gl.RGBA,gl.RGBA,gl.UNSIGNED_BYTE,image);s.textures.set(image,texture);s.ownedTextures.add(texture);}
 gl.viewport(0,0,width,height);if(s.batching){gl.enable(gl.BLEND);gl.blendFunc(gl.ONE,gl.ONE_MINUS_SRC_ALPHA);}else{gl.disable(gl.BLEND);gl.clearColor(0,0,0,0);gl.clear(gl.COLOR_BUFFER_BIT);}gl.disable(gl.DEPTH_TEST);gl.disable(gl.CULL_FACE);gl.useProgram(s.program);gl.bindBuffer(gl.ARRAY_BUFFER,s.vertices);gl.bufferData(gl.ARRAY_BUFFER,data,gl.DYNAMIC_DRAW);gl.enableVertexAttribArray(s.position);gl.vertexAttribPointer(s.position,2,gl.FLOAT,false,16,0);gl.enableVertexAttribArray(s.uv);gl.vertexAttribPointer(s.uv,2,gl.FLOAT,false,16,8);gl.bindBuffer(gl.ELEMENT_ARRAY_BUFFER,s.indices);gl.bufferData(gl.ELEMENT_ARRAY_BUFFER,new Uint16Array(indices),gl.DYNAMIC_DRAW);gl.activeTexture(gl.TEXTURE0);gl.bindTexture(gl.TEXTURE_2D,texture);gl.uniform1i(s.sampler,0);gl.drawElements(gl.TRIANGLES,indices.length,gl.UNSIGNED_SHORT,0);if(!s.batching)ctx.drawImage(canvas,0,0);
