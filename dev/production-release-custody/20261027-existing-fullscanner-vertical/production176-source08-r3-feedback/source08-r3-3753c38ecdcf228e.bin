  {id:'serving-portion-support',layerId:'serving-portion',kind:'support',point:foodPoint,target:'prop:serving-right-plate',active:p>=.86,targetPoint:plateSupport}
 ],screen:assets.screen,phase:p<=.78?'action':p<.86?'release':p<.98?'contact':'settled',worldSupportQualified:false};}
