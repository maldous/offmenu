}
function drawSource(canvas,loaded,frame){const ctx=canvas.getContext('2d'),viewport=fitSourceViewport(canvas.width,canvas.height,loaded.module.reference.width/loaded.module.reference.height);ctx.setTransform(1,0,0,1,0,0);ctx.fillStyle='#d9dde2';ctx.fillRect(0,0,canvas.width,canvas.height);beginTexturedFrame(ctx);sourceScreen(ctx,frame.screen,loaded.module.reference.anchors?.tabletGlass,loaded.module.reference,viewport);for(const layer of [...frame.layers].sort((a,b)=>a.order-b.order)){const img=layer.image,rect=layer.rect||[0,0,1,1],sample=layer.sample||[0,0,1,1],mesh=layer.rasterMesh,uv=mesh?.source||[[rect[0],rect[1]],[rect[0]+rect[2],rect[1]],[rect[0],rect[1]+rect[3]],[rect[0]+rect[2],rect[1]+rect[3]]],target=layer.deformedUV||uv;const transform=layer.transform||{},pivot=transform.pivot||[.5,.5],shift=transform.shift||[0,0],a=transform.angle||0,c=Math.cos(a),s=Math.sin(a);const source=uv.map(([u,v])=>[(sample[0]+(u-rect[0])/rect[2]*sample[2])*img.naturalWidth,(sample[1]+(v-rect[1])/rect[3]*sample[3])*img.naturalHeight]);const dest=target.map(([u,v])=>{const x=u-pivot[0],y=v-pivot[1];return[viewport.x+(pivot[0]+x*c-y*s+shift[0])*viewport.width,viewport.y+(pivot[1]+x*s+y*c+shift[1])*viewport.height];});const indices=mesh?.indices||[0,2,1,1,2,3];drawTexturedMesh(ctx,img,source,dest,indices);}endTexturedFrame(ctx);}
export async function mountSourceActionPreview(canvas,moduleURL){const loaded=await loadSceneModule(moduleURL,{loadImage:image});const state={qualification:'SOURCE_PART_ACTION_ONLY_NOT_WORLD_ACCEPTANCE',id:loaded.module.id,frames:0,progress:0,contacts:[],finished:false,error:null};const chapter=createModuleChapter(loaded,{draw(progress,frame){state.progress=progress;state.contacts=frame.contacts;state.frames++;drawSource(canvas,loaded,frame);}});const master=createChapterMaster({chapters:[chapter],host:canvas.parentNode,onError(error){state.error=error.message;}});const visibility=()=>master.setPaused(document.hidden);document.addEventListener('visibilitychange',visibility);visibility();master.start();master.completion.then(result=>{state.finished=true;state.result=result.status;master.dispose();chapter.dispose();disposeTexturedMesh(canvas.getContext('2d'));document.removeEventListener('visibilitychange',visibility);});const dispose=()=>{master.dispose();chapter.dispose();disposeTexturedMesh(canvas.getContext('2d'));document.removeEventListener('visibilitychange',visibility);};addEventListener('pagehide',dispose,{once:true});return{getState:()=>structuredClone(state),dispose};}
// Bounded source-preview mesh raster only: no world, camera, clock or UI policy.
// One GPU indexed draw owns shared edges; independent Canvas2D AA clips do not.
const surfaces=new WeakMap();
function compile(gl,type,source){const shader=gl.createShader(type);gl.shaderSource(shader,source);gl.compileShader(shader);if(!gl.getShaderParameter(shader,gl.COMPILE_STATUS))throw Error(gl.getShaderInfoLog(shader));return shader;}
