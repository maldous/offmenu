export function disposeTexturedMesh(ctx){const s=surfaces.get(ctx);if(!s)return;for(const t of s.ownedTextures)s.gl.deleteTexture(t);s.gl.deleteBuffer(s.vertices);s.gl.deleteBuffer(s.indices);s.gl.deleteProgram(s.program);s.ownedTextures.clear();surfaces.delete(ctx);}

// A finite source frame retains layer order/alpha in one GPU surface and transfers once to Canvas2D.
export function beginTexturedFrame(ctx){const s=surfaces.get(ctx)||create(ctx);if(s.batching)throw Error('Nested source frame');s.batching=true;const{gl,canvas}=s;if(canvas.width!==ctx.canvas.width||canvas.height!==ctx.canvas.height){canvas.width=ctx.canvas.width;canvas.height=ctx.canvas.height;}gl.clearColor(0,0,0,0);gl.clear(gl.COLOR_BUFFER_BIT);}
export function endTexturedFrame(ctx){const s=surfaces.get(ctx);if(!s?.batching)throw Error('No source frame');s.batching=false;ctx.drawImage(s.canvas,0,0);}
// Serving: pan stability, loaded spoon travel, persistent food transfer, retract.
export const id=8;
export const durationMs=3200;
const W=1014,H=624,panGrip=[278,212],spoonGrip=[187,360],foodBase=[524,453],plateSupport=[604,490];
