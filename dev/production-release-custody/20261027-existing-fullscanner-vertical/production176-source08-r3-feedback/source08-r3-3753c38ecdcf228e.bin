const clamp=x=>Math.max(0,Math.min(1,x));
// Hermite trajectory with continuous internal velocities; explicit stop at support.
function curve(p,keys){
 if(p<=keys[0][0])return keys[0][1];if(p>=keys.at(-1)[0])return keys.at(-1)[1];
 const slope=i=>keys[i][2]??(i===0||i===keys.length-1?0:(keys[i+1][1]-keys[i-1][1])/(keys[i+1][0]-keys[i-1][0]));
 for(let i=1;i<keys.length;i++)if(p<=keys[i][0]){const a=keys[i-1],b=keys[i],dt=b[0]-a[0],t=(p-a[0])/dt,t2=t*t,t3=t2*t;return(2*t3-3*t2+1)*a[1]+(t3-2*t2+t)*dt*slope(i-1)+(-2*t3+3*t2)*b[1]+(t3-t2)*dt*slope(i);}
}
function spoonPose(p){return{rigidX:103,pivot:spoonGrip,shift:[curve(p,[[0,-45],[.18,-25],[.38,-25],[.65,0],[.78,70],[.88,72],[1,0]]),curve(p,[[0,-100],[.18,-95],[.38,-50],[.65,0],[.78,25],[.88,25],[1,-55]])],angle:curve(p,[[0,-.08],[.3,-.04],[.65,0],[.78,0],[.86,.12],[.95,.04],[1,0]])};}
