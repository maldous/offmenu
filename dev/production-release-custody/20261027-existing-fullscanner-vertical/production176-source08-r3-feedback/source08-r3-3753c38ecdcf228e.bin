  {id:'serving-spoon-grip',layerId:'serving-spoon-hand',kind:'grip',point:rigid(spoonGrip,spoon),target:'prop:serving-spoon',active:true,targetPoint:rigid(spoonGrip,spoon)},
  {id:'serving-portion-carry',layerId:'serving-portion',kind:'grip',point:foodPoint,target:'prop:serving-spoon',active:p<=.78,targetPoint:rigid(foodBase,spoon)},
