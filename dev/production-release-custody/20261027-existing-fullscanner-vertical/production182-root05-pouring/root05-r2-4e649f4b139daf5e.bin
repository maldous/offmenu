export async function prepareWorld05Binding(loaded,shared,{readJSON,loadImage}){
 if(loaded.module.id!==5||loaded.module.durationMs!==3400)throw Error('Exact authored pouring chapter required');
 const base=new URL('../pouring-world-r4/',import.meta.url);
 const [geometry,bounds,spec,scaleImage]=await Promise.all([
  readJSON(new URL('bowl-scale-geometry.json',base)),
  readJSON(new URL('source-bounds.json',base)),
  readJSON(new URL('room-counter-extended.json',base)),
  loadImage(new URL('../../../scene05-join-scale-successor-20261027/r1/assets/scene-05/scale.png',import.meta.url).href),
 ]);
 const localShared={...shared,room:{...shared.room,spec}},fixed=supportedMeshes(geometry,loaded.assets,scaleImage),camera=geometry.camera;
 return{shared:localShared,camera,bind(frame){
  const bound=bindPouring(loaded,frame,geometry,bounds);
  return{
   frame:{...frame,layers:[]},
   registration:{camera,referenceCamera:camera,placements:{}},
   contacts:frame.contacts,
   supports:[{id:'bowl-on-scale',error:bound.bowlSupportError},{id:'scale-on-worktop',error:bound.scaleSupportError}],
   drawExtras(renderer){drawMeshes(renderer,fixed,camera);drawPouringLayers(renderer,bound.layers,camera);},
