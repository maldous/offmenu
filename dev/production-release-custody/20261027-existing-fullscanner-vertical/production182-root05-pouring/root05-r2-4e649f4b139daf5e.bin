export function drawPouringLayers(renderer,layers,camera){const gl=renderer.gl,p=renderer.program;gl.useProgram(p);gl.enable(gl.DEPTH_TEST);gl.depthFunc(gl.LEQUAL);gl.depthMask(true);for(const l of layers){gl.depthMask(l.id!=='pour-forearm');const data=[];for(const i of l.indices){const w=l.weights?.[i]||1;data.push(...project(l.world[i],camera),l.source[i][0]*w,l.source[i][1]*w,w);}gl.bindBuffer(gl.ARRAY_BUFFER,renderer.buffer);gl.bufferData(gl.ARRAY_BUFFER,new Float32Array(data),gl.DYNAMIC_DRAW);for(const[name,size,offset]of[['position',3,0],['uv',3,12]]){const loc=gl.getAttribLocation(p,name);gl.enableVertexAttribArray(loc);gl.vertexAttribPointer(loc,size,gl.FLOAT,false,24,offset);}gl.bindTexture(gl.TEXTURE_2D,renderer.texture(l.image));gl.uniform4fv(gl.getUniformLocation(p,'sampleRect'),[0,0,1,1]);gl.uniform1i(gl.getUniformLocation(p,'polyCount'),0);gl.uniform1i(gl.getUniformLocation(p,'outside'),0);gl.uniform1f(gl.getUniformLocation(p,'opacity'),1);gl.drawArrays(gl.TRIANGLES,0,data.length/6);}gl.depthMask(true);}
