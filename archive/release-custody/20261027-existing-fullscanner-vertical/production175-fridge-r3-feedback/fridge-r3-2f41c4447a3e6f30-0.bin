import {V,project} from '../../landing-first-pair-v12-integration/scene-camera.mjs';
// Coherent shared-room camera candidate. Never substitute a per-view fake tablet or move the fridge exterior.
export const worldCamera={position:[-.6,1.2,1.1],lookAt:[-1.83,3.55,.20],up:[0,0,1],focal:48,aspect:1041/645};
const clamp=x=>Math.max(0,Math.min(1,x)),ease=x=>{x=clamp(x);return x*x*(3-2*x);};
const sourceBase=[290,410],propScale=.0013,bodyScale=.0018,boxSource=[181,307,367,411];
const near={id:'leftovers-near-arm',root:[492,407],grip:[274,395],releaseAt:.9,releaseDuration:.1};
const far={id:'leftovers-far-hand',root:[466,373],grip:[363,334],releaseAt:.84,releaseDuration:.12};
function poseWorld(geometry,p){
 const shelf=geometry.surfaces.find(s=>s.id==='fridge-shelf-support').quad,[left,right]=shelf,front=V.scale(V.add(left,right),.5),backward=V.unit(V.sub(shelf[3],shelf[0]));
 // Centre the visible container bbox, rather than its uncertain concealed bottom tip, within the real opening.
 const target=V.add(front,V.scale(backward,.10));target[0]+=(sourceBase[0]-(boxSource[0]+boxSource[2])/2)*propScale+.025;
 const travel=ease((p-.40)/.40),align=ease((p-.12)/.28);
 const base=[target[0]+.11*(1-align),target[1]-.32*(1-travel),geometry.support.shelfZ+.045*(1-ease((p-.65)/.15))];
 const bodyRoot=[right[0]+.16,right[1]-.20,geometry.support.shelfZ+.015];
 return {base,target,bodyRoot,travel,backward,shelf};
}
/** Actual source action sampled once; master maps its source meshes into fixed shared XYZ and retargets the exact grip vertices. */
export function bindPhysicalLeftovers(loaded,frame,p,geometry){
 const pose=poseWorld(geometry,p),{base,bodyRoot}=pose,W=loaded.module.reference.width,H=loaded.module.reference.height;
 const body=uv=>[bodyRoot[0]+(uv[0]*W-near.root[0])*bodyScale,bodyRoot[1],bodyRoot[2]+(near.root[1]-uv[1]*H)*bodyScale];
 const prop=([x,y])=>[base[0]+(x-sourceBase[0])*propScale,base[1],base[2]+(sourceBase[1]-y)*propScale];
 const layers=[],contacts=[];
 for(const layer of frame.layers){
  if(layer.id==='leftovers-container'){
   const [x0,y0,x1,y1]=boxSource,source=[[x0/W,y0/H],[x1/W,y0/H],[x0/W,y1/H],[x1/W,y1/H]];
   layers.push({id:layer.id,image:layer.image,source,indices:[0,2,1,1,2,3],world:source.map(uv=>prop([uv[0]*W,uv[1]*H]))});continue;
  }
  const mesh=layer.rasterMesh;if(!mesh)throw Error('Measured source mesh required for '+layer.id);
  let world=(layer.deformedUV||mesh.source).map(body);const hand=[near,far].find(h=>h.id===layer.id);
  if(hand){
   const gripIndex=mesh.source.findIndex(uv=>Math.hypot(uv[0]-hand.grip[0]/W,uv[1]-hand.grip[1]/H)<1e-10);
   if(gripIndex<0)throw Error('Actual source grip is not a mesh vertex');
   const gripSource=frame.contacts.find(c=>c.kind==='grip'&&c.layerId===layer.id);if(!gripSource)throw Error('Authored grip contact missing');
   const release=ease((p-hand.releaseAt)/hand.releaseDuration),target=prop(hand.grip),free=gripSource.point.map((v,i)=>v-gripSource.targetPoint[i]);
   target[0]+=free[0]*propScale;target[1]-=.14*release;target[2]-=free[1]*propScale;
   const delta=V.sub(target,world[gripIndex]),axis=V.sub(hand.grip,hand.root),length=V.dot(axis,axis);
   world=world.map((point,i)=>{const pixel=[mesh.source[i][0]*W,mesh.source[i][1]*H],weight=clamp(V.dot(V.sub(pixel,hand.root),axis)/length);return V.add(point,V.scale(delta,weight));});
   const actual=world[gripIndex],propGrip=prop(hand.grip);contacts.push({id:gripSource.id,kind:gripSource.active?'grip':'release',active:gripSource.active,worldPoint:actual,worldTarget:propGrip,distance:Math.hypot(...V.sub(actual,propGrip)),rootWorld:body([hand.root[0]/W,hand.root[1]/H])});
  }
  layers.push({id:layer.id,image:layer.image,source:mesh.source,indices:mesh.indices,world});
 }
 const projected=project(base,worldCamera),bbox={min:[base[0]+(boxSource[0]-sourceBase[0])*propScale,base[1],base[2]],max:[base[0]+(boxSource[2]-sourceBase[0])*propScale,base[1]+.18,base[2]+(sourceBase[1]-boxSource[1])*propScale]};
 const shelfX=pose.shelf.map(p=>p[0]),shelfY=pose.shelf.map(p=>p[1]);
 const clearances={left:bbox.min[0]-Math.min(...shelfX),right:Math.max(...shelfX)-bbox.max[0],front:bbox.min[1]-Math.min(...shelfY),back:Math.max(...shelfY)-bbox.max[1]};
 const support={id:'leftovers-base-support',active:p>=.8,worldPoint:base,planeZ:geometry.support.shelfZ,distance:Math.abs(base[2]-geometry.support.shelfZ)};
 return {layers,contacts,support,container:{base,scaleMetersPerSourcePixel:propScale,conservativeVolume:bbox,clearances,projectedNative:[(projected[0]+1)/2*W,(1-projected[1])/2*H]},qualification:'FIXED_WORLD_SOURCE_MESH_BINDING_CANDIDATE_NOT_NATURAL_HUMAN_OR_PHYSICAL_RELEASE_ACCEPTANCE',limits:'Body/prop scale and camera framing are explicit integration candidates. The visible source bottom is inferred (±20x/±12y px). Conservative volume is not a recovered closed textured 3D container; no anatomy or complete prop underside is claimed.'};
}
/** Same existing shader/texture cache; no extra canvas, renderer, clock, or depth-buffer clear. */
export function drawPhysicalLayers(renderer,bound,camera=worldCamera){
 const gl=renderer.gl,p=renderer.program;gl.useProgram(p);gl.enable(gl.DEPTH_TEST);gl.depthFunc(gl.LEQUAL);gl.depthMask(true);
 for(const layer of bound.layers){const data=[];for(const i of layer.indices)data.push(...project(layer.world[i],camera),...layer.source[i],1);gl.bindBuffer(gl.ARRAY_BUFFER,renderer.buffer);gl.bufferData(gl.ARRAY_BUFFER,new Float32Array(data),gl.DYNAMIC_DRAW);for(const[name,size,offset]of[['position',3,0],['uv',3,12]]){const loc=gl.getAttribLocation(p,name);gl.enableVertexAttribArray(loc);gl.vertexAttribPointer(loc,size,gl.FLOAT,false,24,offset);}gl.bindTexture(gl.TEXTURE_2D,renderer.texture(layer.image));gl.uniform4fv(gl.getUniformLocation(p,'sampleRect'),[0,0,1,1]);gl.uniform1i(gl.getUniformLocation(p,'polyCount'),0);gl.uniform1i(gl.getUniformLocation(p,'outside'),0);gl.uniform1f(gl.getUniformLocation(p,'opacity'),1);gl.drawArrays(gl.TRIANGLES,0,data.length/6);}
}
