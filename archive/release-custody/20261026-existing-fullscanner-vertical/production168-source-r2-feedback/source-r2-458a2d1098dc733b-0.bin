import {grid,smooth} from '../action-math.mjs';
import {track} from '../choreography-r3/motion.mjs';
export function sourceSkin(mesh,{width,height,root,index},pose,{pinCrop=false}={}){const axis=[index[0]-root[0],index[1]-root[1]],length=axis[0]**2+axis[1]**2,c=Math.cos(pose.angle),s=Math.sin(pose.angle);return mesh.source.map(([u,v])=>{const x=u*width,y=v*height,t=((x-root[0])*axis[0]+(y-root[1])*axis[1])/length;let weight=smooth(t/.85);if(pinCrop)weight*=smooth((width-x)/200)*smooth((height-y)/200);const dx=x-index[0],dy=y-index[1],mx=index[0]+c*dx-s*dy+pose.shift[0],my=index[1]+s*dx+c*dy+pose.shift[1];return [(x+(mx-x)*weight)/width,(y+(my-y)*weight)/height];});}
export function poseFor(id,p){const shifts=id===11?[[0,85,72,.065],[.12,96,82,.085],[.38,0,0,0],[.66,0,0,0],[.76,24,30,.035],[.94,85,72,.065],[1,85,72,.065]]:[[0,68,70,.06],[.15,78,82,.085],[.43,0,0,0],[.66,0,0,0],[.78,22,35,.025],[.94,68,70,.06],[1,68,70,.06]];return {shift:[track(p,shifts.map(a=>[a[0],a[1]])),track(p,shifts.map(a=>[a[0],a[2]]))],angle:track(p,shifts.map(a=>[a[0],a[3]]))};}
export function bodyLayer(core,id,p,reference){const width=reference.width,height=reference.height,root=id===11?[785,470]:[1000,663],neckControl=id===11?[995,320]:[1010,290];const mesh=grid(width,height,{root,index:root,extra:[[800,100],[850,200],[900,300],[950,380],[1000,450]]});
 const lean=track(p,id===11?[[0,0],[.18,-.023],[.38,-.016],[.66,-.013],[.80,.006],[1,0]]:[[0,0],[.16,-.014],[.37,-.026],[.51,-.018],[.68,-.012],[.86,.005],[1,0]]);
 const nod=track(p,id===11?[[0,0],[.20,-.070],[.40,-.036],[.58,-.052],[.68,-.025],[.87,.012],[1,0]]:[[0,0],[.18,-.050],[.41,-.070],[.55,-.035],[.68,-.045],[.88,.008],[1,0]]);
 const uv=mesh.source.map(([u,v])=>{const x=u*width,y=v*height,edge=smooth((width-x)/22)*smooth((height-y)/30),rootWeight=smooth(Math.hypot(x-root[0],y-root[1])/80),upper=smooth((440-y)/230),a=lean*rootWeight*edge,c=Math.cos(a),s=Math.sin(a);let X=root[0]+c*(x-root[0])-s*(y-root[1]),Y=root[1]+s*(x-root[0])+c*(y-root[1]);
  const head=upper*smooth((x-770)/90)*edge,n=nod*head,C=Math.cos(n),S=Math.sin(n),dx=X-neckControl[0],dy=Y-neckControl[1];return [(neckControl[0]+C*dx-S*dy)/width,(neckControl[1]+S*dx+C*dy)/height];});
 return {...core,rasterMesh:mesh,deformedUV:uv,bodyMotion:'Source-visible head/cloth lean with crop edge and arm join pinned; controls not anatomical claims'};}
