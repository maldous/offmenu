// One finite browser check for the new raster helper. No clock/server/page navigation.
import {drawTexturedMesh,disposeTexturedMesh} from './seamless-layer-raster-r1.mjs';
export function checkSourceMeshRaster(){const make=(w,h)=>{const c=document.createElement('canvas');c.width=w;c.height=h;return c;},target=make(320,240),ctx=target.getContext('2d',{willReadFrequently:true});
 const source=make(48,48),s=source.getContext('2d');for(const [color,x,y] of [['#ff0000',0,0],['#00ff00',24,0],['#0000ff',0,24],['#ffff00',24,24]]){s.fillStyle=color;s.fillRect(x,y,24,24);}
 const positions=[],uv=[],indices=[];for(let y=0;y<=16;y++)for(let x=0;x<=20;x++){uv.push([x/20*48,y/16*48]);positions.push([13.25+x/20*267,11.75+y/16*171]);}for(let y=0;y<16;y++)for(let x=0;x<20;x++){const a=y*21+x,b=a+1,c=a+21,d=c+1;indices.push(a,b,c,b,d,c);}
 drawTexturedMesh(ctx,source,uv,positions,indices);let minOpaqueAlpha=255;const pixels=ctx.getImageData(16,15,260,164).data;for(let i=3;i<pixels.length;i+=4)minOpaqueAlpha=Math.min(minOpaqueAlpha,pixels[i]);if(minOpaqueAlpha!==255)throw Error('Internal mesh coverage hole alpha'+minOpaqueAlpha);
 const expected=[[65,50,[255,0,0]],[225,50,[0,255,0]],[65,150,[0,0,255]],[225,150,[255,255,0]]];for(const [x,y,color] of expected){const p=ctx.getImageData(x,y,1,1).data;if(color.some((v,i)=>Math.abs(v-p[i])>1))throw Error('Texture orientation/color mismatch '+JSON.stringify([...p]));}
 const translucent=make(48,48),t=translucent.getContext('2d');t.fillStyle='rgba(80,140,210,.5)';t.fillRect(0,0,48,48);ctx.clearRect(0,0,320,240);drawTexturedMesh(ctx,translucent,uv,positions,indices);const alpha=ctx.getImageData(16,15,260,164).data;let min=255,max=0;for(let i=3;i<alpha.length;i+=4){min=Math.min(min,alpha[i]);max=Math.max(max,alpha[i]);}if(min<126||max>129)throw Error('Shared edge alpha changed '+min+'..'+max);disposeTexturedMesh(ctx);return {status:'PASS',minOpaqueAlpha,translucentAlphaRange:[min,max],orientation:'four corners match',triangles:indices.length/3,qualification:'Finite helper draw only, not author motion/world/landing acceptance'};
}
