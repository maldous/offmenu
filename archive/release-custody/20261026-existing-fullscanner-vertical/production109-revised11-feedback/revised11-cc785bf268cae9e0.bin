import {grid} from '../action-math.mjs';

import {track} from '../choreography-r3/motion.mjs';
export const id=14;export const durationMs=3450;
const target=[239.2438188167724,445.3456873761134],root=[576,720],width=1014,height=663;
export const reference={width,height,source:{path:'/home/user/src/offmenu-data/runtime/layout-migration/worker05/native-browser-kitchen-15-20261026/v4-keyframe-world/targets/target-14.png',sha256:'044362773d2ba4580cdc713d47555d3713b491dd2a87da33eb9b79d3116b11bb'},anchors:{neck:null,shoulder:null,elbow:null,wrist:null,index:target,grip:null,support:null,armCropRoot:root,propBase:null,tabletGlass:[[108,96],[540,57],[618,489],[171,552]]},anchorReasons:{neck:'Original source head retained, no verified anatomical joint required for bounded cloth/head response.',shoulder:'Clothed and not verified; authored offcrop root is a control, not shoulder anatomy.',elbow:'Offcrop; no inferred anatomical landmark.',wrist:'Newly generated visible hand/forearm with distributed source skin controls; no verified original-source wrist claimed.',grip:'No prop; notebook omitted by latest direct user app-order requirement.',support:'No prop setdown; app indication only.',propBase:'No moving prop in new action.'},action:'App-based Order review: prepare hand, reach to existing Review order control, one brief contact/indication, inspect unchanged approved synthetic screen, retract with follow-through.',newMaterial:'New authorized source-registered hand/forearm candidate, exact original actorCore and screen retained. No paper/notebook layer, generated UI, invented order or actual transaction.',tabletContactUV:[0.17628458498023716,0.7964601769911505],targetPose:.45};
const mesh=grid(width,height,{root,index:target,extra:[[415,580],[485,650]]});
const bodyRoot=[1000,663],bodyMesh=grid(width,height,{root:bodyRoot,index:bodyRoot});
export async function load({loadImage,resolveAsset}){return {arm:await loadImage(resolveAsset('./interaction-arm.png')),core:await loadImage(resolveAsset('../assets/scene-14/actorCore.png')),screen:await loadImage(resolveAsset('../assets/scene-14/approved-screen.png'))};}
const ease=x=>{x=Math.max(0,Math.min(1,x));return x*x*(3-2*x);};
function skin(pose){const axis=[target[0]-root[0],target[1]-root[1]],length=axis[0]**2+axis[1]**2,c=Math.cos(pose.angle),s=Math.sin(pose.angle);return mesh.source.map(uv=>{const x=uv[0]*width,y=uv[1]*height,t=((x-root[0])*axis[0]+(y-root[1])*axis[1])/length,w=ease(t/.65),dx=x-target[0],dy=y-target[1],mx=target[0]+c*dx-s*dy+pose.shift[0],my=target[1]+s*dx+c*dy+pose.shift[1];return [(x+(mx-x)*w)/width,(y+(my-y)*w)/height];});}
function pose(p){return {shift:[track(p,[[0,105],[.12,116],[.25,85],[.42,0],[.48,0],[.53,10],[.66,18],[.88,105],[1,105]]),track(p,[[0,70],[.12,80],[.25,50],[.42,0],[.48,0],[.53,10],[.66,14],[.88,70],[1,70]])],angle:track(p,[[0,.055],[.12,.075],[.28,-.018],[.42,0],[.48,0],[.61,.025],[.84,.065],[1,.055]])};}
export function sample(p,assets){const raw=pose(p),transform={shift:raw.shift.map(v=>v*.72),angle:raw.angle*.65},uv=skin(transform),tip=[target[0]+transform.shift[0],target[1]+transform.shift[1]];
 const bow=track(p,[[0,0],[.12,-4],[.28,7],[.42,0],[.48,0],[.60,-4],[.82,5],[1,0]]),axis=[target[0]-root[0],target[1]-root[1]],length=Math.hypot(...axis),normal=[-axis[1]/length,axis[0]/length];
 const armUV=uv.map((v,i)=>{const s=mesh.source[i],x=s[0]*width,y=s[1]*height,t=((x-root[0])*axis[0]+(y-root[1])*axis[1])/(length*length),dist=Math.hypot(x-target[0],y-target[1]),w=t>0&&t<1?Math.sin(Math.PI*t)**2*ease((dist-155)/70):0;return [v[0]+normal[0]*bow*w/width,v[1]+normal[1]*bow*w/height];});
 const lean=track(p,[[0,0],[.14,-.004],[.33,.009],[.48,.007],[.64,.004],[.9,0],[1,0]]),bodyUV=bodyMesh.source.map(([u,v])=>{const x=u*width-bodyRoot[0],y=v*height-bodyRoot[1],weight=Math.min(1,Math.max(0,(height-v*height)/260)),a=lean*weight,c=Math.cos(a),s=Math.sin(a);return [(bodyRoot[0]+c*x-s*y)/width,(bodyRoot[1]+s*x+c*y)/height];});
 return {layers:[{id:'order-app-interaction-arm',image:assets.arm,role:'actor',order:30,rasterMesh:mesh,deformedUV:armUV},{id:'order-app-actor-core',image:assets.core,role:'foreground',order:40,rasterMesh:bodyMesh,deformedUV:bodyUV}],contacts:[{id:'order-review-index-glass',kind:'tap',layerId:'order-app-interaction-arm',point:tip,target:'tablet',targetPoint:target,active:p>=.42&&p<=.48,glassUV:reference.tabletContactUV,sourceUncertaintyPixels:2,frontNormalSeparationInTabletWidths:p>=.42&&p<=.48?0:Math.min(.16,Math.hypot(...transform.shift)/430)}],screen:assets.screen,phase:p===1?'settled':p>=.42&&p<=.48?'contact':p>.48?'release':'action',motionStage:p<.16?'prepare':p<.42?'reach-to-order-review':p<.49?'brief-review-control-contact':p<.68?'inspect-order-review':p<.90?'retract-follow-through':'settled'};
}
