export async function load({loadImage,resolveAsset}){const out={};for(const n of ['actorCore','jarReachArm','benchSupportArm','carton'])out[n]=await loadImage(resolveAsset('./assets/scene-12/'+n+'.png'));out.stockJar=await loadImage(resolveAsset('./assets/scene-12/stockJar-complete.png'));out.screen=await loadImage(resolveAsset('./assets/scene-12/approved-screen.png'));return out;}
export function sample(value,assets){const p=progress(value),w=contactWeight(p),uv=mesh.source.map(v=>reachPoint(v,w,guides,reference.width,reference.height)),tip=reachPoint(mesh.indexContact,w,guides,reference.width,reference.height).map((v,i)=>v*(i?reference.height:reference.width));return{layers:[{id:'planning-stock-jar',image:assets.stockJar,role:'prop',order:10},{id:'planning-carton',image:assets.carton,role:'prop',order:11},{id:'planning-support-arm',image:assets.benchSupportArm,role:'actor',order:25},{id:'planning-reach-arm',image:assets.jarReachArm,role:'actor',order:30,rasterMesh:mesh,deformedUV:uv},{id:'planning-actor-core',image:assets.actorCore,role:'foreground',order:40}],contacts:[{id:'planning-jar-touch',layerId:'planning-reach-arm',kind:'tap',point:tip,target:'prop:planning-stock-jar',active:p>=.6&&p<=.72,targetPoint:[838,198],sourceUncertaintyPixels:5},{id:'planning-bench-support',layerId:'planning-support-arm',kind:'support',point:[447,504],target:'worktop',active:true}],screen:assets.screen,phase:phase(p)};}
