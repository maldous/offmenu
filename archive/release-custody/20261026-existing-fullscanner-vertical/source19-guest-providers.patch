+// Adapter for the existing selected temporary public Demo endpoint only.
+// No source corpus, authentication, private state, image or upstream fallback.
+const exactCode=value=>typeof value==='string'&&/^(?:\d{8}|\d{12}|\d{13}|\d{14})$/.test(value);
+const unavailable=(generation,error)=>({generation,status:'unavailable',matches:[],hasMore:false,nextCursor:null,error});
+const nullableText=(value,max)=>value===null||typeof value==='string'&&value.length<=max&&
+  !/[\u0000-\u001f\u007f]/.test(value);
+const field=(value,pointer)=>({state:value===null?'null':'present',value,
+  fieldPointer:pointer,valueOrigin:'temporary-public-demo-response',
+  sourceFieldState:'original-field-presence-unknown'});
+async function boundedJSON(response){
+  if(!response.headers.get('Content-Type')?.includes('application/json'))throw Error('DEMO_JSON_REQUIRED');
+  const reader=response.body?.getReader();if(!reader)throw Error('DEMO_RESPONSE_REQUIRED');
+  const parts=[];let length=0;
+  try{for(;;){const {done,value}=await reader.read();if(done)break;length+=value.byteLength;
+    if(length>16384){await reader.cancel();throw Error('DEMO_RESPONSE_BOUND');}parts.push(value);}}
+  finally{reader.releaseLock();}
+  const bytes=new Uint8Array(length);let at=0;for(const part of parts){bytes.set(part,at);at+=part.length;}
+  return JSON.parse(new TextDecoder('utf-8',{fatal:true}).decode(bytes));
+}
+export function createGuestDemoLookup({fetchImpl=globalThis.fetch,origin=globalThis.location?.origin}={}){
+  return async function lookup(raw,generation,cursor=null,symbology=null,namespace='barcode'){
+    if(cursor!==null||namespace!=='barcode'||!exactCode(raw))return unavailable(generation,'DEMO_EXACT_BARCODE_REQUIRED');
+    let base;try{base=new URL(origin);if(base.origin!==origin||!['http:','https:'].includes(base.protocol))throw Error();}
+    catch{return unavailable(generation,'DEMO_ORIGIN_REQUIRED');}
+    if(typeof fetchImpl!=='function')return unavailable(generation,'DEMO_PUBLIC_LOOKUP_UNAVAILABLE');
+    try{
+      const url=new URL('/demo/api/product',base);url.searchParams.set('barcode',raw);
+      const response=await fetchImpl(url.href,{method:'GET',credentials:'omit',cache:'no-store',
+        redirect:'error',mode:'same-origin',headers:{Accept:'application/json'},signal:AbortSignal.timeout(12000)});
+      if(response.status===404)return {generation,status:'scoped-miss',matches:[],hasMore:false,nextCursor:null,
+        original:raw,namespace,symbology,sourceId:'off',lookupScope:'one temporary Open Food Facts public lookup only'};
+      if(!response.ok)return unavailable(generation,'DEMO_PUBLIC_LOOKUP_UNAVAILABLE');
+      const data=await boundedJSON(response),source=data.source;
+      if(data.status!=='found'||data.barcode!==raw||!nullableText(data.name,200)||
+        !nullableText(data.brand,200)||!nullableText(data.quantity,100)||
+        source?.name!=='Open Food Facts'||source.url!=='https://world.openfoodfacts.org/product/'+raw||
+        source.license!=='ODbL'||source.licenseUrl!=='https://opendatacommons.org/licenses/odbl/1-0/')
+        throw Error('DEMO_PUBLIC_PRODUCT_BINDING');
+      // id is the exact returned publisher URL, not an invented corpus ID,
+      // observation reference, published release, semantic match or admission.
+      const match={id:source.url,name:data.name,brand:data.brand,sourceObservationReference:null,
+        provenance:{sourceId:'off',url:source.url,attribution:source.name,license:source.license,licenseUrl:source.licenseUrl},
+        detail:{fields:{name:field(data.name,'/name'),brand:field(data.brand,'/brand'),
+          packageQuantity:field(data.quantity,'/quantity')},
+          sourceBinding:{sourceId:'off',url:source.url},sourcePhotoSelection:null,
+          canonicalCategory:null,canonicalIngredient:null,
+          projectionLimitations:['Temporary public response supplies only product name, brand and source quantity text. Other fields and original source presence are unknown.'],
+          assurance:'Temporary attributed public lookup; no retained corpus, ingredient suitability, source release or independent acceptance is established.'}};
+      return {generation,status:'source-match',matches:[match],hasMore:false,nextCursor:null,
+        original:raw,namespace,symbology,sourceId:'off',lookupScope:'temporary-public-demo'};
+    }catch{return unavailable(generation,'DEMO_PUBLIC_LOOKUP_UNAVAILABLE');}
+  };
+}
+export const lookupIdentifiers=createGuestDemoLookup();
+export function mergeIdentifierPages(){throw Error('DEMO_LOOKUP_HAS_NO_CONTINUATION');}
+export function localRetainedCategorySelected(){return false;}
+export async function lookupLocalRetainedCategory(_raw,generation){return unavailable(generation,'DEMO_PRIVATE_CORPUS_DISABLED');}
