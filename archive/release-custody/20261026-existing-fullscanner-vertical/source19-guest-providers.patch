+import {createGuestStorage,readGuestPrefill,finishGuestSession} from './guest-scanner-state.mjs';
+import {createGuestDemoLookup,mergeIdentifierPages,localRetainedCategorySelected,
+  lookupLocalRetainedCategory} from './guest-scanner-lookup.mjs';
+const unavailable=generation=>({generation,status:'unavailable',matches:[],hasMore:false,nextCursor:null,
+  error:'DEMO_PUBLIC_PROVIDER_NOT_SELECTED'});
+// Explicit binding to the already selected public endpoint's inspected source
+// contract. This pin describes that contract; it is not an auth/serving grant.
+export function createGuestDemoProviders({selection,origin=globalThis.location?.origin,fetchImpl=globalThis.fetch}={}){
+  const storage=createGuestStorage();let epoch=0,closed=false;
+  const selected=selection?.kind==='public-demo-off'&&
+    selection.sourceContractSha256==='02962e94a09ac7a6a36ba608479b4c1ca5e54a9f2931a9b291f48ce6496b5a00';
+  const lookup=selected?createGuestDemoLookup({origin,fetchImpl}):async(_raw,generation)=>unavailable(generation);
+  return Object.freeze({scope:'guest-demo',storage,mergeIdentifierPages,localRetainedCategorySelected,
+    lookupLocalRetainedCategory,readGuestPrefill,finishGuestSession,
+    async lookupIdentifiers(raw,generation,cursor=null,symbology=null,namespace='barcode'){
+      if(closed)return unavailable(generation);const turn=epoch;
+      const result=await lookup(raw,generation,cursor,symbology,namespace);
+      return closed||turn!==epoch?unavailable(generation):result;
+    },
+    reset(){epoch++;storage.clear();},
+    destroy(){closed=true;epoch++;storage.clear();}
+  });
+}
