// Bounded source-space mesh authoring only. No clock, camera, world depth or room.
export function progress(value){if(!Number.isFinite(value)||value<0||value>1)throw RangeError('Finite scene progress0..1 required');return value;}
export const smooth=value=>{const x=Math.max(0,Math.min(1,value));return x*x*(3-2*x);};
export function contactWeight(p){progress(p);if(p<.6)return smooth(p/.6);if(p<=.72)return 1;return 1-smooth((p-.72)/.28);}
export function phase(p){return p===1?'settled':p>=.6&&p<=.72?'contact':p>.72?'release':'action';}
export function grid(width,height,{root,index,extra=[]}){
 const xs=[...new Set([...Array.from({length:25},(_,i)=>i/24),root[0]/width,index[0]/width,...extra.map(p=>p[0]/width)].filter(v=>v>=0&&v<=1))].sort((a,b)=>a-b);
 const ys=[...new Set([...Array.from({length:17},(_,i)=>i/16),root[1]/height,index[1]/height,...extra.map(p=>p[1]/height)].filter(v=>v>=0&&v<=1))].sort((a,b)=>a-b);
 const source=ys.flatMap(y=>xs.map(x=>[x,y])),indices=[];
 for(let y=0;y<ys.length-1;y++)for(let x=0;x<xs.length-1;x++){const i=y*xs.length+x,j=i+xs.length;indices.push(i,j,i+1,i+1,j,j+1);}
 return {source,indices,root:[root[0]/width,root[1]/height],indexContact:[index[0]/width,index[1]/height]};
}
export function posedPoint(point,{root,bend,index},weight,width,height){
 const p=[point[0]*width,point[1]*height],axis=[index[0]-root[0],index[1]-root[1]],length=axis[0]**2+axis[1]**2;
 const along=((p[0]-root[0])*axis[0]+(p[1]-root[1])*axis[1])/length;
 const local=smooth((along-.05)/.65),a=(1-weight)*.085*local,c=Math.cos(a),s=Math.sin(a);
 const x=p[0]-bend[0],y=p[1]-bend[1];const rotated=[bend[0]+x*c-y*s,bend[1]+x*s+y*c];
 // The source cuff/root is fixed; distal hand bends smoothly, not one translated arm card.
 return [(p[0]+(rotated[0]-p[0])*local)/width,(p[1]+(rotated[1]-p[1])*local)/height];
}
export function deform(mesh,guides,weight,width,height){return mesh.source.map(p=>posedPoint(p,guides,weight,width,height));}
